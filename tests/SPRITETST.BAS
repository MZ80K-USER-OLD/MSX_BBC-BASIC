10 MODE 2,1,1
20 SPRITE INIT
30 P$=STRING$(16,CHR$(255))+STRING$(16,CHR$(129))
40 SPRITE$(0)=P$
50 CLS
60 PRINT "SPRITE TEST: 16X16, DOUBLE (BOUNCING)"
70 X0=20:Y0=20:DX0=3:DY0=2:C0=15
80 X1=200:Y1=40:DX1=-2:DY1=3:C1=6
90 X2=60:Y2=150:DX2=2:DY2=-3:C2=9
100 XMIN=0:XMAX=232:YMIN=16:YMAX=168
110 T0=TIME
120 REPEAT
130 X0=X0+DX0:Y0=Y0+DY0
140 IF X0<=XMIN OR X0>=XMAX THEN DX0=-DX0
150 IF Y0<=YMIN OR Y0>=YMAX THEN DY0=-DY0
160 X1=X1+DX1:Y1=Y1+DY1
170 IF X1<=XMIN OR X1>=XMAX THEN DX1=-DX1
180 IF Y1<=YMIN OR Y1>=YMAX THEN DY1=-DY1
190 X2=X2+DX2:Y2=Y2+DY2
200 IF X2<=XMIN OR X2>=XMAX THEN DX2=-DX2
210 IF Y2<=YMIN OR Y2>=YMAX THEN DY2=-DY2
220 PUT SPRITE 0,(X0,Y0),C0,0
230 PUT SPRITE 1,(X1,Y1),C1,0
240 PUT SPRITE 2,(X2,Y2),C2,0
250 UNTIL TIME-T0>500
260 MODE 2,0,0
270 CLS
280 PRINT "SPRITE TEST: 8X8, NORMAL (BOUNCING)"
290 X0=20:Y0=20:DX0=4:DY0=3:C0=15
300 X1=200:Y1=40:DX1=-3:DY1=4:C1=6
310 X2=60:Y2=150:DX2=3:DY2=-4:C2=9
320 XMIN=0:XMAX=248:YMIN=16:YMAX=184
330 T0=TIME
340 REPEAT
350 X0=X0+DX0:Y0=Y0+DY0
360 IF X0<=XMIN OR X0>=XMAX THEN DX0=-DX0
370 IF Y0<=YMIN OR Y0>=YMAX THEN DY0=-DY0
380 X1=X1+DX1:Y1=Y1+DY1
390 IF X1<=XMIN OR X1>=XMAX THEN DX1=-DX1
400 IF Y1<=YMIN OR Y1>=YMAX THEN DY1=-DY1
410 X2=X2+DX2:Y2=Y2+DY2
420 IF X2<=XMIN OR X2>=XMAX THEN DX2=-DX2
430 IF Y2<=YMIN OR Y2>=YMAX THEN DY2=-DY2
440 PUT SPRITE 0,(X0,Y0),C0,0
450 PUT SPRITE 1,(X1,Y1),C1,0
460 PUT SPRITE 2,(X2,Y2),C2,0
470 UNTIL TIME-T0>500
480 SPRITE OFF
490 CLS
500 PRINT "SPRITE TEST DONE"
510 END
