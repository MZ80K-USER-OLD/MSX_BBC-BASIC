  2034  0767  f5                OSWRCH:	PUSH	AF
  2035  0768  d5                	PUSH	DE
  2036  0769  e5                	PUSH	HL
  2037  076a  cd0000            	CALL  msxCHPUT
  2038  076d  e1                	POP	HL
  2039  076e  d1                	POP	DE
  2040  076f  f1                	POP	AF
  2041  0770  c9                	RET
  2042                          ;
  2043                          ;OSLINE - Read/edit a complete line, terminated by CR.
  2044                          ;   Inputs: HL addresses destination buffer.
  2045                          ;           (L=0)
  2046                          ;  Outputs: Buffer filled, terminated by CR.
  2047                          ;           A=0.
  2048                          ; Destroys: A,B,C,D,E,H,L,F
  2049                          ;
  2050                          OSLINE:
  2051                          INLINE:
  2052  0771  eb                	EX DE,HL
  2053  0772  d5                	PUSH DE
  2054  0773  cd0000            	CALL msxPINLINE   ; 一行入力 入力先 BUF
  2055  0776  d1                    POP DE
  2056  0777  380d              	JR C,OSLINE_STOP   ; CTRL-STOPが押されたら終わり
  2057                          INLINE0:
  2058  0779  23                	INC HL 		; HL=BUF-1 　だから
  2059  077a  7e                	LD A,(HL)
  2060  077b  12                	LD (DE),A
  2061  077c  13                	INC DE
  2062  077d  b7                	OR A
  2063  077e  20f9              	JR NZ,INLINE0
  2064  0780  12                	LD (DE),A	; NULL 終端
  2065  0781  1b                	DEC DE
  2066  0782  3e0d              	LD A,CR
  2067  0784  12                	LD (DE),A	; 0DH,NULL
  2068  0785  c9                	RET
  2069                          
  2070                          OSLINE_STOP:
  2071  0786  3e0d              	LD A,CR
  2072  0788  12                	LD (DE),A	; 0DH
  2073  0789  13                	INC DE
  2074  078a  af                	XOR A
  2075  078b  12                	LD (DE),A	; NULL 終端
  2076  078c  37                	SCF			; CTRL-STOPが押されたことを示す
  2077  078d  c9                	RET
  2078                          ;
  2079                          ; INIT SCREEN
  2080                          ;
  2081                          INITTXT:
  2082  078e  3e50              	LD A,80
  2083  0790  320000            	LD (WIDTH),A
  2084  0793  c30000            	JP msxINITXT80
  2085                          
  2086                          ;------------------------------------------------------------------------------
  2087                          ; Check Msx-DOS Version (MSX1 or MSX2)
  2088                          ; ------------------------------------------------------------------------------
  2089                          CheckMSXDOS:
  2090                              ; --- バージョン取得 ---
  2091  0796  010000                ld   bc, 0000h   ; 初期化
  2092  0799  0e6f                  ld   c, 6Fh      ; _DOSVER
  2093  079b  cd0500                call BDOS       ; BDOS
  2094                          
  2095  079e  78                    ld   a, b        ; メジャーバージョン
  2096  079f  320000                ld   (DOS_VER), a ; 変数に格納
  2097                          
  2098                              ; --- 判定と表示 ---
  2099  07a2  3a0000            	ld   a, (DOS_VER)
  2100  07a5  fe02                  cp   2
  2101  07a7  3006                  jr   nc, print_dos2
  2102                          
  2103                          print_dos1:
  2104  07a9  21b507                LD HL, MSG_DOS1
  2105  07ac  c30000                JP msxSTRPUT
  2106                          
  2107                          print_dos2:
  2108  07af  21c107                LD HL, MSG_DOS2
  2109  07b2  c30000                JP msxSTRPUT
  2110                          
  2111                          
  2112                          ; --- データエリア ---
  2113  07b5  4d53582d444f5320  MSG_DOS1: DEFB "MSX-DOS 1",0DH,0AH,00
              310d0a00          
  2114  07c1  4d53582d444f5320  MSG_DOS2: DEFB "MSX-DOS 2",0DH,0AH,00
              320d0a00          
  2115                          
  2116                          ; ======================================================
  2117                          ; HLレジスタの内容をASCII 4文字で画面に表示する
  2118                          ; ======================================================
  2119                          PrintAddress:
  2120  07cd  7c                    ld  a, h
  2121  07ce  cdd207                call PrintHexByte   ; 上位バイト(H)を表示
  2122  07d1  7d                    ld  a, l            ; 下位バイト(L)を表示
  2123                              ; そのまま下の PrintHexByte へ流れる (Fall-through)
  2124                          
  2125                          ; --- 1バイト(A)を16進ASCII 2文字で表示 ---
  2126                          PrintHexByte:
  2127  07d2  f5                    push af             ; 下位ニブル保存用
  2128  07d3  0f                    rrca
  2129  07d4  0f                	rrca 		        ; 上位4ビットを下位へ移動
  2130  07d5  0f                    rrca
  2131  07d6  0f                	rrca
  2132  07d7  cddb07                call PrintNibble    ; 上位桁を表示
  2133  07da  f1                    pop  af             ; 下位ニブルを戻す
  2134                              ; そのまま下の PrintNibble へ流れる
  2135                          
  2136                          ; --- 下位4ビット(A)をASCII 1文字で表示 (DAAマジック) ---
  2137                          PrintNibble:
  2138  07db  e60f                  and  0Fh            ; 下位4ビットのみにマスク
  2139  07dd  c690                  add  a, 90h         ; 10進補正を利用するためのオフセット
  2140  07df  27                    daa                 ; 0-9はそのまま、A-Fは桁上げが発生
  2141  07e0  ce40                  adc  a, 40h         ; ASCII '0'(30h)や'A'(41h)への調整
  2142  07e2  27                    daa                 ; 最終的なASCIIコードに確定
  2143                          
  2144                          ; --- [システム依存] 1文字出力ルーチン ---
  2145                              ; Aレジスタの文字を表示します。
  2146                              ; お使いの環境に合わせて書き換えてください。
  2147                          PUTCHAR::
  2148  07e3  c30000            	JP msxCHPUT ; 画面に表示 (自動的にXが+1される)
  2149                          
  2150                          PUTCRLF:
  2151  07e6  3e0d              	LD A,CR
  2152  07e8  cd0000            	CALL msxCHPUT
  2153  07eb  3e0a              	LD  A,LF
  2154  07ed  c30000            	JP  msxCHPUT
  2155                          
  2156                          PROMPT:
  2157  07f0  3e3e              	LD A,'>'
  2158  07f2  c30000            	JP msxCHPUT
  2159                          ;
  2160                          ; HLレジスタの指す文字列を画面に出力するルーチン
  2161                          ; 文字列はNULL(0)で終端されているもの
  2162                          STRPUT:
  2163  07f5  c30000                JP msxSTRPUT ; 文字列出力
  2164                          
  2165                          ;
  2166                          ;
  2167                          ;EDITST:	DEFM	"EDIT"
  2168                          ;LISTST:	DEFM	"LIST"
  2169                          ;
  2170                          BEL	EQU	7
  2171                          BS	EQU	8
  2172                          HT	EQU	9
  2173                          LF	EQU	0AH
  2174                          VT	EQU	0BH
  2175                          CR	EQU	0DH
  2176                          ESC	EQU	1BH
  2177                          DEL	EQU	7FH
  2178                          ;
  2179                          FCB	EQU	5CH
  2180                          DSKBUF	EQU	80H
  2181                          ;
  2182                          FCBSIZ	EQU	128+36+2
  2183                          BLOCKSIZE EQU 256
  2184                          ;
  2185  07f8  0a                TRPCNT:	DEFB	10
  2186  07f9  0000000000000000  TABLE:	DEFS	16		;FILE BLOCK POINTERS
              0000000000000000  
  2187  0809  00                FLAGS:	DEFB	0
  2188  080a  00                INKEY:	DEFB	0
  2189  080b  0000              EDPTR:	DEFW	0
  2190  080d  00                OPTVAL:	DEFB	0
  2191                          INILEN	EQU	$-TABLE
  2192                          ;
  2193                          FIN:	;END
