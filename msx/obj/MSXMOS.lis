   607                          ; OSSHUT - close one channel, or all normal channels when E=0.
   608                          OSSHUT:
   609  029e  7b                	LD	A,E
   610  029f  b7                	OR	A
   611  02a0  200e              	JR	NZ,DOS2_CLOSE_ONE
   612  02a2  1e01              	LD	E,1
   613                          DOS2_CLOSE_ALL:
   614  02a4  d5                	PUSH	DE
   615  02a5  cdb502            	CALL	DOS2_CLOSE_IF_OPEN
   616  02a8  d1                	POP	DE
   617  02a9  1c                	INC	E
   618  02aa  7b                	LD	A,E
   619  02ab  fe08              	CP	8
   620  02ad  38f5              	JR	C,DOS2_CLOSE_ALL
   621  02af  c9                	RET
   622                          DOS2_CLOSE_ONE:
   623  02b0  cd0f02            	CALL	DOS2_FIND
   624  02b3  180c              	JR	DOS2_CLOSE_HANDLE
   625                          DOS2_CLOSE_IF_OPEN:
   626  02b5  1600              	LD	D,0
   627  02b7  210000            	LD	HL,DOS2_HANDLES
   628  02ba  19                	ADD	HL,DE
   629  02bb  7e                	LD	A,(HL)
   630  02bc  b7                	OR	A
   631  02bd  c8                	RET	Z
   632  02be  320000            	LD	(FILE_HANDLE),A
   633                          DOS2_CLOSE_HANDLE:
   634  02c1  d5                	PUSH	DE
   635  02c2  cdd101            	CALL	HCLOSE
   636  02c5  d1                	POP	DE
   637  02c6  b7                	OR	A
   638  02c7  c0                	RET	NZ
   639  02c8  1600              	LD	D,0
   640  02ca  210000            	LD	HL,DOS2_HANDLES
   641  02cd  19                	ADD	HL,DE
   642  02ce  3600              	LD	(HL),0
   643  02d0  210000            	LD	HL,DOS2_EOF
   644  02d3  19                	ADD	HL,DE
   645  02d4  3600              	LD	(HL),0
   646  02d6  c9                	RET
   647                          
   648                          OSBGET:
   649  02d7  d5                	PUSH	DE
   650  02d8  cd0f02            	CALL	DOS2_FIND
   651  02db  110000            	LD	DE,DOS2_IOBUF
   652  02de  210100            	LD	HL,1
   653  02e1  cddb01            	CALL	HREAD
   654  02e4  d1                	POP	DE
   655  02e5  b7                	OR	A
   656  02e6  c23101            	JP	NZ,FILE_DOS2_ERROR
   657  02e9  7c                	LD	A,H
   658  02ea  b5                	OR	L
   659  02eb  200a              	JR	NZ,DOS2_BGET_BYTE
   660  02ed  1600              	LD	D,0
   661  02ef  210000            	LD	HL,DOS2_EOF
   662  02f2  19                	ADD	HL,DE
   663  02f3  3601              	LD	(HL),1
   664  02f5  37                	SCF
   665  02f6  c9                	RET
   666                          DOS2_BGET_BYTE:
   667  02f7  3a0000            	LD	A,(DOS2_IOBUF)
   668  02fa  b7                	OR	A
   669  02fb  c9                	RET
   670                          
   671                          OSBPUT:
   672  02fc  f5                	PUSH	AF
   673  02fd  d5                	PUSH	DE
   674  02fe  cd0f02            	CALL	DOS2_FIND
   675  0301  d1                	POP	DE
   676  0302  f1                	POP	AF
   677  0303  320000            	LD	(DOS2_IOBUF),A
   678  0306  110000            	LD	DE,DOS2_IOBUF
   679  0309  210100            	LD	HL,1
   680  030c  cdfd01            	CALL	HWRITE
   681  030f  b7                	OR	A
   682  0310  c23101            	JP	NZ,FILE_DOS2_ERROR
   683  0313  7c                	LD	A,H
   684  0314  b5                	OR	L
   685  0315  ca3101            	JP	Z,FILE_DOS2_ERROR
   686  0318  1600              	LD	D,0
   687  031a  210000            	LD	HL,DOS2_EOF
   688  031d  19                	ADD	HL,DE
   689  031e  3600              	LD	(HL),0
   690  0320  c9                	RET
   691                          
   692                          OSSTAT:
   693  0321  cd0f02            	CALL	DOS2_FIND
   694  0324  1600              	LD	D,0
   695  0326  210000            	LD	HL,DOS2_EOF
   696  0329  19                	ADD	HL,DE
   697  032a  7e                	LD	A,(HL)
   698  032b  3d                	DEC	A
   699  032c  c9                	RET
   700                          
   701                          ; HSEEK - seek FILE_HANDLE. A=origin, DE=low offset, HL=high offset.
   702                          HSEEK:
   703  032d  f5                	PUSH	AF
   704  032e  3a0000            	LD	A,(FILE_HANDLE)
   705  0331  47                	LD	B,A
   706  0332  f1                	POP	AF
   707  0333  0e4a              	LD	C,4AH
   708  0335  cd0500            	CALL	BDOS
   709  0338  c9                	RET
   710                          
   711                          GETPTR:
   712  0339  cd0f02            	CALL	DOS2_FIND
   713  033c  af                	XOR	A
   714  033d  110000            	LD	DE,0
   715  0340  210000            	LD	HL,0
   716  0343  c32d03            	JP	HSEEK
   717                          
   718                          PUTPTR:
   719  0346  d9                	EXX
   720  0347  5f                	LD	E,A
   721  0348  cd0f02            	CALL	DOS2_FIND
   722  034b  d9                	EXX
   723  034c  af                	XOR	A
   724  034d  c32d03            	JP	HSEEK
   725                          
   726                          GETEXT:
   727  0350  cd0f02            	CALL	DOS2_FIND
   728  0353  af                	XOR	A
   729  0354  110000            	LD	DE,0
   730  0357  210000            	LD	HL,0
   731  035a  cd2d03            	CALL	HSEEK
   732  035d  d9                	EXX
   733  035e  3e02              	LD	A,2
   734  0360  110000            	LD	DE,0
   735  0363  210000            	LD	HL,0
   736  0366  cd2d03            	CALL	HSEEK
   737  0369  d9                	EXX
   738  036a  af                	XOR	A
   739  036b  cd2d03            	CALL	HSEEK
   740  036e  d9                	EXX
   741  036f  c9                	RET
   742                          
   743                          SESHUT:
   744  0370  210908            	LD	HL,FLAGS
   745  0373  cb86              	RES	0,(HL)
   746  0375  cb8e              	RES	1,(HL)
   747  0377  1e08              	LD	E,8
   748  0379  c3b502            	JP	DOS2_CLOSE_IF_OPEN
   749                          
   750                          ; Open the reserved SPOOL/EXEC channel (channel 8).
   751                          DOS2_OPEN8:
   752  037c  f5                	PUSH	AF
   753  037d  cdd303            	CALL	PATHSAVE
   754  0380  cd0604            	CALL	PATHNORM
   755  0383  cd2904            	CALL	DOS2_DEFAULT_EXT
   756  0386  f1                	POP	AF
   757  0387  110000            	LD	DE,PATHBUF
   758  038a  3805              	JR	C,DOS2_OPEN8_READ
   759  038c  cdc201            	CALL	HCREATE
   760  038f  1805              	JR	DOS2_OPEN8_RESULT
   761                          DOS2_OPEN8_READ:
   762  0391  3e00              	LD	A,0
   763  0393  cdb401            	CALL	HOPEN
   764                          DOS2_OPEN8_RESULT:
   765  0396  b7                	OR	A
   766  0397  2802              	JR	Z,DOS2_OPEN8_OK
   767  0399  af                	XOR	A
   768  039a  c9                	RET
   769                          DOS2_OPEN8_OK:
   770  039b  3a0000            	LD	A,(FILE_HANDLE)
   771  039e  320800            	LD	(DOS2_HANDLES+8),A
   772  03a1  af                	XOR	A
   773  03a2  320800            	LD	(DOS2_EOF+8),A
   774  03a5  3e08              	LD	A,8
   775  03a7  c30000            	JP	CHECK
   776                          
   777                          NOTFND:
   778  03aa  3ed6              	LD	A,214
   779  03ac  cd0000            	CALL	EXTERR
   780  03af  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   781  03bd  00                	DEFB	0
   782                          #endif
   783                          
   784                          ; Preserve interpreter registers around non-file BDOS calls.
   785                          BDOS0:
   786  03be  c5                	PUSH	BC
   787  03bf  d5                	PUSH	DE
   788  03c0  e5                	PUSH	HL
   789  03c1  dde5              	PUSH	IX
   790  03c3  fde5              	PUSH	IY
   791  03c5  4f                	LD	C,A
   792  03c6  cd0500            	CALL	BDOS
   793  03c9  24                	INC	H
   794  03ca  25                	DEC	H
   795  03cb  fde1              	POP	IY
   796  03cd  dde1              	POP	IX
   797  03cf  e1                	POP	HL
   798  03d0  d1                	POP	DE
   799  03d1  c1                	POP	BC
   800  03d2  c9                	RET
   801                          
   802                          ;OSOPEN - Open a file for reading or writing.
   803                          ;   Inputs: HL addresses filename (term CR)
   804                          ;           Carry set for OPENIN, cleared for OPENOUT.
   805                          ;   Outputs: A = file channel (=0 if cannot open)
   806                          ;            DE = file FCB
   807                          ;   Destroys: A,B,C,D,E,H,L,F
   808                          ;
   809                          #ifdef CPM
   810                          OPENIT:	PUSH	AF		;SAVE CARRY
   811                          	CALL	SETUP0
   812                          	POP	AF
   813                          	CALL	NC,CREATE
   814                          	CALL	C,OPEN
   815                          	RET
   816                          ;
   817                          OSOPEN:	CALL	OPENIT
   818                          	RET	Z		;ERROR
   819                          	LD	B,7		;MAX. NUMBER OF FILES
   820                          	LD	HL,TABLE+15
   821                          OPEN1:	LD	A,(HL)
   822                          	DEC	HL
   823                          	OR	(HL)
   824                          	JR	Z,OPEN2		;FREE CHANNEL
   825                          	DEC	HL
   826                          	DJNZ	OPEN1
   827                          	LD	A,192
   828                          	CALL	EXTERR
   829                          	DEFM	"Too many open files"
   830                          	DEFB	0
   831                          
   832                          OPEN2:	LD	DE,(FREE)	;FREE SPACE POINTER
   833                          	LD	(HL),E
   834                          	INC	HL
   835                          	LD	(HL),D
   836                          	LD	A,B		;CHANNEL (1-7)
   837                          	LD	HL,FCBSIZ
   838                          	ADD	HL,DE		;RESERVE SPACE
   839                          	LD	(FREE),HL
   840                          OPEN3:	LD	HL,FCB		;ENTRY FROM SPOOL/EXEC
   841                          	PUSH	DE
   842                          	LD	BC,36
   843                          	LDIR			;COPY FCB
   844                          	EX	DE,HL
   845                          	INC	HL
   846                          	LD	(HL),C		;CLEAR PTR
   847                          	INC	HL
   848                          	POP	DE
   849                          	LD	B,A
   850                          	CALL	RDF		;READ OR FILL
   851                          	LD	A,B
   852                          	JP	CHECK
   853                          ;
   854                          ;OSBPUT - Write a byte to a random disk file.
   855                          ;   Inputs: E = file channel
   856                          ;           A = byte to write
   857                          ; Destroys: A,B,C,F
   858                          ;
   859                          OSBPUT:	PUSH	DE
   860                          	PUSH	HL
   861                          	LD	B,A
   862                          	CALL	FIND
   863                          	LD	A,B
   864                          	LD	B,0
   865                          	DEC	HL
   866                          	LD	(HL),B		;CLEAR EOF
   867                          	INC	HL
   868                          	LD	C,(HL)
   869                          	RES	7,C
   870                          	SET	7,(HL)
   871                          	INC	(HL)
   872                          	INC	HL
   873                          	PUSH	HL
   874                          	ADD	HL,BC
   875                          	LD	(HL),A
   876                          	POP	HL
   877                          	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   878                          	POP	HL
   879                          	POP	DE
   880                          	RET
   881                          ;
   882                          ;OSBGET - Read a byte from a random disk file.
   883                          ;   Inputs: E = file channel
   884                          ;  Outputs: A = byte read
   885                          ;           Carry set if LAST BYTE of file
   886                          ; Destroys: A,B,C,F
   887                          ;
   888                          OSBGET:	PUSH	DE
   889                          	PUSH	HL
   890                          	CALL	FIND
   891                          	LD	C,(HL)
   892                          	RES	7,C
   893                          	INC	(HL)
   894                          	INC	HL
   895                          	PUSH	HL
   896                          	LD	B,0
   897                          	ADD	HL,BC
   898                          	LD	B,(HL)
   899                          	POP	HL
   900                          	CALL	PE,INCRDF	;INC SECTOR THEN READ
   901                          	CALL	Z,WRRDF		;WRITE THEN READ/FILL
   902                          	LD	A,B
   903                          	POP	HL
   904                          	POP	DE
   905                          	RET
   906                          ;
   907                          ;OSSTAT - Read file status.
   908                          ;   Inputs: E = file channel
   909                          ;  Outputs: Z flag set - EOF
   910                          ;           (If Z then A=0)
   911                          ;           DE = address of file block.
   912                          ; Destroys: A,D,E,H,L,F
   913                          ;
   914                          OSSTAT:	CALL	FIND
   915                          	DEC	HL
   916                          	LD	A,(HL)
   917                          	INC	A
   918                          	RET
   919                          ;
   920                          ;GETEXT - Find file size.
   921                          ;   Inputs: E = file channel
   922                          ;  Outputs: DEHL = file size (0-&800000)
   923                          ; Destroys: A,B,C,D,E,H,L,F
   924                          ;
   925                          GETEXT:	CALL	FIND
   926                          	EX	DE,HL
   927                          	LD	DE,FCB
   928                          	LD	BC,36
   929                          	PUSH	DE
   930                          	LDIR			;COPY FCB
   931                          	EX	DE,HL
   932                          	EX	(SP),HL
   933                          	EX	DE,HL
   934                          	LD	A,35
   935                          	CALL	BDOS1		;COMPUTE SIZE
   936                          	POP	HL
   937                          	XOR	A
   938                          	JR	GETPT1
   939                          ;
   940                          ;GETPTR - Return file pointer.
   941                          ;   Inputs: E = file channel
   942                          ;  Outputs: DEHL = pointer (0-&7FFFFF)
   943                          ; Destroys: A,B,C,D,E,H,L,F
   944                          ;
   945                          GETPTR:	CALL	FIND
   946                          	LD	A,(HL)
   947                          	ADD	A,A
   948                          	DEC	HL
   949                          GETPT1:	DEC	HL
   950                          	LD	D,(HL)
   951                          	DEC	HL
   952                          	LD	E,(HL)
   953                          	DEC	HL
   954                          	LD	H,(HL)
   955                          	LD	L,A
   956                          	SRL	D
   957                          	RR	E
   958                          	RR	H
   959                          	RR	L
   960                          	RET
   961                          ;
   962                          ;PUTPTR - Update file pointer.
   963                          ;   Inputs: A = file channel
   964                          ;           DEHL = new pointer (0-&7FFFFF)
   965                          ; Destroys: A,B,C,D,E,H,L,F
   966                          ;
   967                          PUTPTR:	LD	D,L
   968                          	ADD	HL,HL
   969                          	RL	E
   970                          	LD	B,E
   971                          	LD	C,H
   972                          	LD	E,A		;CHANNEL
   973                          	PUSH	DE
   974                          	CALL	FIND
   975                          	POP	AF
   976                          	AND	7FH
   977                          	BIT	7,(HL)		;PENDING WRITE?
   978                          	JR	Z,PUTPT1
   979                          	OR	80H
   980                          PUTPT1:	LD	(HL),A
   981                          	PUSH	DE
   982                          	PUSH	HL
   983                          	DEC	HL
   984                          	DEC	HL
   985                          	DEC	HL
   986                          	LD	D,(HL)
   987                          	DEC	HL
   988                          	LD	E,(HL)
   989                          	EX	DE,HL
   990                          	OR	A
   991                          	SBC	HL,BC
   992                          	POP	HL
   993                          	POP	DE
   994                          	RET	Z
   995                          	INC	HL
   996                          	OR	A
   997                          	CALL	M,WRITE
   998                          	PUSH	HL
   999                          	DEC	HL
  1000                          	DEC	HL
  1001                          	DEC	HL
  1002                          	LD	(HL),0
  1003                          	DEC	HL
  1004                          	LD	(HL),B
  1005                          	DEC	HL
  1006                          	LD	(HL),C		;NEW RECORD NO.
  1007                          	POP	HL
  1008                          	JR	RDF
  1009                          ;
  1010                          ;WRRDF - Write, read; if EOF fill with zeroes.
  1011                          ;RDF - Read; if EOF fill with zeroes.
  1012                          ;   Inputs: DE address FCB.
  1013                          ;           HL addresses data buffer.
  1014                          ;  Outputs: A=0, Z-flag set.
  1015                          ;           Carry set if fill done (EOF)
  1016                          ; Destroys: A,H,L,F
  1017                          ;
  1018                          WRRDF:	CALL	WRITE
  1019                          RDF:	CALL	READ
  1020                          	DEC	HL
  1021                          	RES	7,(HL)
  1022                          	DEC	HL
  1023                          	LD	(HL),A		;CLEAR EOF FLAG
  1024                          	RET	Z
  1025                          	LD	(HL),-1		;SET EOF FLAG
  1026                          	INC	HL
  1027                          	INC	HL
  1028                          	PUSH	BC
  1029                          	XOR	A
  1030                          	LD	B,128
  1031                          FILL:	LD	(HL),A
  1032                          	INC	HL
  1033                          	DJNZ	FILL
  1034                          	POP	BC
  1035                          	SCF
  1036                          	RET
  1037                          ;
  1038                          ;INCRDF - Increment record, read; if EOF fill.
  1039                          ;   Inputs: DE addresses FCB.
  1040                          ;           HL addresses data buffer.
  1041                          ;  Outputs: A=1, Z-flag reset.
  1042                          ;           Carry set if fill done (EOF)
  1043                          ; Destroys: A,H,L,F
  1044                          ;
  1045                          INCRDF:	CALL	INCSEC
  1046                          	CALL	RDF
  1047                          	INC	A
  1048                          	RET
  1049                          ;
  1050                          ;READ - Read a record from a disk file.
  1051                          ;   Inputs: DE addresses FCB.
  1052                          ;           HL = address to store data.
  1053                          ;  Outputs: A<>0 & Z-flag reset indicates EOF.
  1054                          ;           Carry = 0
  1055                          ; Destroys: A,F
  1056                          ;
  1057                          ;BDOS1 - CP/M BDOS call.
  1058                          ;   Inputs: A = function number
  1059                          ;          DE = parameter
  1060                          ;  Outputs: AF = result (carry=0)
  1061                          ; Destroys: A,F
  1062                          ;
  1063                          READ:	CALL	SETDMA
  1064                          	LD	A,33
  1065                          BDOS1:	CALL	BDOS0
  1066                          	JR	NZ,CPMERR
  1067                          	OR	A
  1068                          	RET
  1069                          CPMERR:	LD	A,255
  1070                          	CALL	EXTERR
  1071                          	DEFM	"CP/M Error"
  1072                          	DEFB	0
  1073                          ;
  1074                          BDOS0:	PUSH	BC
  1075                          	PUSH	DE
  1076                          	PUSH	HL
  1077                          	PUSH	IX
  1078                          	PUSH	IY
  1079                          	LD	C,A
  1080                          	CALL	BDOS
  1081                          	INC	H
  1082                          	DEC	H
  1083                          	POP	IY
  1084                          	POP	IX
  1085                          	POP	HL
  1086                          	POP	DE
  1087                          	POP	BC
  1088                          	RET
  1089                          ;
  1090                          ;WRITE - Write a record to a disk file.
  1091                          ;   Inputs: DE addresses FCB.
  1092                          ;           HL = address to get data.
  1093                          ; Destroys: A,F
  1094                          ;
  1095                          WRITE:	CALL	SETDMA
  1096                          	LD	A,40
  1097                          	CALL	BDOS1
  1098                          	JR	Z,INCSEC
  1099                          	LD	A,198
  1100                          	CALL	EXTERR
  1101                          	DEFM	"Disk full"
  1102                          	DEFB	0
  1103                          ;
  1104                          ;INCSEC - Increment random record number.
  1105                          ;   Inputs: DE addresses FCB.
  1106                          
  1107                          INCSEC:	PUSH	HL
  1108                          	LD	HL,33
  1109                          	ADD	HL,DE
  1110                          INCS1:	INC	(HL)
  1111                          	INC	HL
  1112                          	JR	Z,INCS1
  1113                          	POP	HL
  1114                          	RET
  1115                          
  1116                          ;OPEN - Open a file for access.
  1117                          ;   Inputs: FCB set up.
  1118                          ;   Outputs: DE = FCB
  1119                          ;            A=0 & Z-flag set indicates Not Found.
  1120                          ;            Carry = 0
  1121                          ;   Destroys: A,D,E,F
  1122                          ;
  1123                          OPEN:	LD	DE,FCB
  1124                          	LD	A,15
  1125                          	CALL	BDOS1
  1126                          	INC	A
  1127                          	RET
  1128                          
  1129                          ;CREATE - Create a disk file for writing.
  1130                          ;   Inputs: FCB set up.
  1131                          ;   Outputs: DE = FCB
  1132                          ;            A=0 & Z-flag set indicates directory full.
  1133                          ;            Carry = 0
  1134                          ;   Destroys: A,D,E,F
  1135                          ;
  1136                          CREATE:	CALL	CHKAMB
  1137                          	LD	DE,FCB
  1138                          	LD	A,19
  1139                          	CALL	BDOS1		;DELETE
  1140                          	LD	A,22
  1141                          	CALL	BDOS1		;MAKE
  1142                          	INC	A
  1143                          	RET
  1144                          ;
  1145                          ;CHKAMB - Check for ambiguous filename.
  1146                          ; Destroys: A,D,E,F
  1147                          ;
  1148                          CHKAMB:	PUSH	BC
  1149                          	LD	DE,FCB
  1150                          	LD	B,12
  1151                          CHKAM1:	LD	A,(DE)
  1152                          	CP	'?'
  1153                          	JR	Z,AMBIG		;AMBIGUOUS
  1154                          	INC	DE
  1155                          	DJNZ	CHKAM1
  1156                          	POP	BC
  1157                          	RET
  1158                          AMBIG:	LD	A,204
  1159                          	CALL	EXTERR
  1160                          	DEFM	"Bad name"
  1161                          	DEFB	0
  1162                          ;
  1163                          ;SETDMA - Set "DMA" address.
  1164                          ;   Inputs: HL = address
  1165                          ; Destroys: A,F
  1166                          ;
  1167                          SETDMA:	LD	A,26
  1168                          	EX	DE,HL
  1169                          	CALL	BDOS0
  1170                          	EX	DE,HL
  1171                          	RET
  1172                          ;
  1173                          ;FIND - Find file parameters from channel.
  1174                          ;   Inputs: E = channel
  1175                          ;  Outputs: DE addresses FCB
  1176                          ;           HL addresses pointer byte (FCB+37)
  1177                          ; Destroys: A,D,E,H,L,F
  1178                          ;
  1179                          FIND:	INC	E		;N.B. channel 8 is SPOOL/EXEC
  1180                          	DEC	E
  1181                          	JR	Z,CHANER
  1182                          	CALL	FIND1
  1183                          	LD	HL,37
  1184                          	ADD	HL,DE
  1185                          	RET	NZ
  1186                          CHANER:	LD	A,222
  1187                          	CALL	EXTERR
  1188                          	DEFM	"Invalid channel"
  1189                          	DEFB	0
  1190                          ;
  1191                          ;FIND1 - Look up file table.
  1192                          ;   Inputs: E = channel
  1193                          ;  Outputs: Z-flag set = file not opened
  1194                          ;           If NZ, DE addresses FCB
  1195                          ;                  HL points into table
  1196                          ; Destroys: A,D,E,H,L,F
  1197                          ;
  1198                          FIND1:	LD	A,E
  1199                          	AND	7
  1200                          	ADD	A,A
  1201                          	LD	E,A
  1202                          	LD	D,0
  1203                          	LD	HL,TABLE
  1204                          	ADD	HL,DE
  1205                          	LD	E,(HL)
  1206                          	INC	HL
  1207                          	LD	D,(HL)
  1208                          	LD	A,D
  1209                          	OR	E
  1210                          	RET
  1211                          #endif
  1212                          ;
  1213                          ;SETUP - Set up File Control Block.
  1214                          ;   Inputs: HL addresses filename
  1215                          ;           Format  [A:]FILENAME[.EXT]
  1216                          ;           Device defaults to current drive
  1217                          ;           Extension defaults to .BBC
  1218                          ;           A = fill character
  1219                          ;  Outputs: HL updated
  1220                          ;           A = terminator
  1221                          ;           BC = 128
  1222                          ; Destroys: A,B,C,H,L,F
  1223                          ;
  1224                          ; MSX-DOS2 path-aware compatibility shim.
  1225                          ; Keep the raw path string in PATHBUF so command handlers can migrate from
  1226                          ; CP/M FCB parsing to path-based DOS calls without immediately breaking the
  1227                          ; legacy file layer.
  1228                          ;
  1229  03d3  110000            PATHSAVE:	LD	DE,PATHBUF
  1230  03d6  af                	XOR	A
  1231  03d7  7e                PATHS1:	LD	A,(HL)
  1232  03d8  b7                	OR	A
  1233  03d9  2828              	JR	Z,PATHS2
  1234  03db  fe0d              	CP	CR
  1235  03dd  2824              	JR	Z,PATHS2
  1236  03df  fe20              	CP	' '
  1237  03e1  2820              	JR	Z,PATHS2
  1238  03e3  fe3d              	CP	'='
  1239  03e5  281c              	JR	Z,PATHS2
  1240  03e7  fe22              	CP	'"'
  1241  03e9  2818              	JR	Z,PATHS2
  1242  03eb  fe7c              	CP	'|'
  1243  03ed  2814              	JR	Z,PATHS2
  1244  03ef  fe2f              	CP	'/'
  1245  03f1  2809              	JR	Z,PATHS3
  1246  03f3  fe5c              	CP	5CH		; '\'
  1247  03f5  2805              	JR	Z,PATHS3
  1248  03f7  12                	LD	(DE),A
  1249  03f8  13                	INC	DE
  1250  03f9  23                	INC	HL
  1251  03fa  18db              	JR	PATHS1
  1252  03fc  3e5c              PATHS3:	LD	A,5CH
  1253  03fe  12                	LD	(DE),A
  1254  03ff  13                	INC	DE
  1255  0400  23                	INC	HL
  1256  0401  18d4              	JR	PATHS1
  1257  0403  af                PATHS2:	XOR	A
  1258  0404  12                	LD	(DE),A
  1259  0405  c9                	RET
  1260                          ;
  1261                          ;PATHNORM - normalise a path string stored in PATHBUF to a DOS2-friendly form.
  1262                          ;   Normalises '/' to '\' and uppercases the drive/path characters.
  1263                          ;   The original FCB-based layer still receives the CP/M-compatible name, but
  1264                          ;   PATHBUF preserves the full path information needed for a later DOS2 switch.
  1265                          ;
  1266  0406  f5                PATHNORM:	PUSH	AF
  1267  0407  d5                	PUSH	DE
  1268  0408  e5                	PUSH	HL
  1269  0409  210000            	LD	HL,PATHBUF
  1270  040c  7e                PATHN1:	LD	A,(HL)
  1271  040d  b7                	OR	A
  1272  040e  2815              	JR	Z,PATHNEND
  1273  0410  fe2f              	CP	'/'
  1274  0412  280b              	JR	Z,PATHN2
  1275  0414  fe5c              	CP	5CH
  1276  0416  2807              	JR	Z,PATHN2
  1277  0418  cd0806            	CALL	UPPRC
  1278  041b  77                	LD	(HL),A
  1279  041c  23                	INC	HL
  1280  041d  18ed              	JR	PATHN1
  1281  041f  3e5c              PATHN2:	LD	A,5CH
  1282  0421  77                	LD	(HL),A
  1283  0422  23                	INC	HL
  1284  0423  18e7              	JR	PATHN1
  1285  0425  e1                PATHNEND:	POP	HL
  1286  0426  d1                	POP	DE
  1287  0427  f1                	POP	AF
  1288  0428  c9                	RET
  1289                          
  1290                          ; Add the BASIC default extension to PATHBUF when the supplied path has none.
  1291                          DOS2_DEFAULT_EXT:
  1292  0429  f5                	PUSH	AF
  1293  042a  c5                	PUSH	BC
  1294  042b  d5                	PUSH	DE
  1295  042c  e5                	PUSH	HL
  1296  042d  210000            	LD	HL,PATHBUF
  1297  0430  0600              	LD	B,0
  1298                          DOS2_EXT_SCAN:
  1299  0432  7e                	LD	A,(HL)
  1300  0433  b7                	OR	A
  1301  0434  2808              	JR	Z,DOS2_EXT_END
  1302  0436  fe2e              	CP	'.'
  1303  0438  2817              	JR	Z,DOS2_EXT_HAVE
  1304  043a  23                	INC	HL
  1305  043b  04                	INC	B
  1306  043c  18f4              	JR	DOS2_EXT_SCAN
  1307                          DOS2_EXT_END:
  1308  043e  78                	LD	A,B
  1309  043f  fe3d              	CP	61			; PATHBUF capacity (including terminator)
  1310  0441  300e              	JR	NC,DOS2_EXT_HAVE
  1311  0443  362e              	LD	(HL),'.'
  1312  0445  23                	INC	HL
  1313  0446  3642              	LD	(HL),'B'
  1314  0448  23                	INC	HL
  1315  0449  3642              	LD	(HL),'B'
  1316  044b  23                	INC	HL
  1317  044c  3643              	LD	(HL),'C'
  1318  044e  23                	INC	HL
  1319  044f  3600              	LD	(HL),0
  1320                          DOS2_EXT_HAVE:
  1321  0451  e1                	POP	HL
  1322  0452  d1                	POP	DE
  1323  0453  c1                	POP	BC
  1324  0454  f1                	POP	AF
  1325  0455  c9                	RET
  1326                          ;
  1327                          #ifndef CPM
  1328                          ; DOS2 operations use PATHBUF directly, not a CP/M File Control Block.
  1329                          SETUP0:
  1330                          SETUP:
  1331  0456  cdd303            	CALL	PATHSAVE
  1332  0459  c35c04            	JP	SKIPSP
  1333                          #endif
  1334                          
  1335                          #ifdef CPM
  1336                          ;FCB FORMAT (36 BYTES TOTAL):
  1337                          ; 0      0=SAME DISK, 1=DISK A, 2=DISK B (ETC.)
  1338                          ; 1-8    FILENAME, PADDED WITH SPACES
  1339                          ; 9-11   EXTENSION, PADDED WITH SPACES
  1340                          ; 12     CURRENT EXTENT, SET TO ZERO
  1341                          ; 32-35  CLEARED TO ZERO
  1342                          ;
  1343                          SETUP0:	LD	A,' '
  1344                          SETUP:	PUSH	DE
  1345                          	PUSH	HL
  1346                          	PUSH	AF
  1347                          	CALL	PATHSAVE
  1348                          	POP	AF
  1349                          	LD	DE,FCB+9
  1350                          	LD	HL,BBC
  1351                          	LD	BC,3
  1352                          	LDIR
  1353                          	LD	HL,FCB+32
  1354                          	LD	B,4
  1355                          SETUP1:	LD	(HL),C
  1356                          	INC	HL
  1357                          	DJNZ	SETUP1
  1358                          	POP	HL
  1359                          	LD	C,A
  1360                          	XOR	A
  1361                          	LD	(DE),A
  1362                          	POP	DE
  1363                          	CALL	SKIPSP
  1364                          	CP	'"'
  1365                          	JR	NZ,SETUP2
  1366                          	INC	HL
  1367                          	CALL	SKIPSP
  1368                          	CALL	SETUP2
  1369                          	CP	'"'
  1370                          	INC	HL
  1371                          	JR	Z,SKIPSP
  1372                          BADSTR:	LD	A,253
  1373                          	CALL	EXTERR
  1374                          	DEFM	"Bad string"
  1375                          	DEFB	0
  1376                          ;
  1377                          PARSE:	LD	A,(HL)
  1378                          	INC	HL
  1379                          	CP	'`'
  1380                          	RET	NC
  1381                          	CP	'?'
  1382                          	RET	C
  1383                          	XOR	40H
  1384                          	RET
  1385                          ;
  1386                          SETUP2:	PUSH	DE
  1387                          	INC	HL
  1388                          	LD	A,(HL)
  1389                          	CP	':'
  1390                          	DEC	HL
  1391                          	LD	A,B
  1392                          	JR	NZ,DEVICE
  1393                          	LD	A,(HL)		;DRIVE
  1394                          	AND	31
  1395                          	INC	HL
  1396                          	INC	HL
  1397                          DEVICE:	LD	DE,FCB
  1398                          	LD	(DE),A
  1399                          	INC	DE
  1400                          	LD	B,8
  1401                          COPYF:	LD	A,(HL)
  1402                          	CP	'.'
  1403                          	JR	Z,COPYF1
  1404                          	CP	' '
  1405                          	JR	Z,COPYF1
  1406                          	CP	CR
  1407                          	JR	Z,COPYF1
  1408                          	CP	'='
  1409                          	JR	Z,COPYF1
  1410                          	CP	'"'
  1411                          	JR	Z,COPYF1
  1412                          	LD	C,'?'
  1413                          	CP	'*'
  1414                          	JR	Z,COPYF1
  1415                          	LD	C,' '
  1416                          	INC	HL
  1417                          	CP	'|'
  1418                          	JR	NZ,COPYF2
  1419                          	CALL	PARSE
  1420                          	JR	COPYF0
  1421                          COPYF1:	LD	A,C
  1422                          COPYF2:	CALL	UPPRC
  1423                          COPYF0:	LD	(DE),A
  1424                          	INC	DE
  1425                          	DJNZ	COPYF
  1426                          COPYF3:	LD	A,(HL)
  1427                          	INC	HL
  1428                          	CP	'*'
  1429                          	JR	Z,COPYF3
  1430                          	CP	'.'
  1431                          	LD	BC,3*256+' '
  1432                          	LD	DE,FCB+9
  1433                          	JR	Z,COPYF
  1434                          	DEC	HL
  1435                          	POP	DE
  1436                          	LD	BC,128
  1437                          ;
  1438                          BBC:	DEFM	"BBC"
  1439                          #endif
  1440                          
  1441  045c  7e                SKIPSP:	LD	A,(HL)
  1442  045d  fe20              	CP	' '
  1443  045f  c0                	RET	NZ
  1444  0460  23                	INC	HL
  1445  0461  18f9              	JR	SKIPSP
  1446                          ;
  1447                          ;HEX - Read a hex string and convert to binary.
  1448                          ;   Inputs: HL = text pointer
  1449                          ;  Outputs: HL = updated text pointer
  1450                          ;           DE = value
  1451                          ;            A = terminator (spaces skipped)
  1452                          ; Destroys: A,D,E,H,L,F
  1453                          ;
  1454  0463  110000            HEX:	LD	DE,0		;INITIALISE
  1455  0466  cd5c04            	CALL	SKIPSP
  1456  0469  7e                HEX1:	LD	A,(HL)
  1457  046a  cd0806            	CALL	UPPRC
  1458  046d  fe30              	CP	'0'
  1459  046f  38eb              	JR	C,SKIPSP
  1460  0471  fe3a              	CP	'9'+1
  1461  0473  380a              	JR	C,HEX2
  1462  0475  fe41              	CP	'A'
  1463  0477  38e3              	JR	C,SKIPSP
  1464  0479  fe47              	CP	'F'+1
  1465  047b  30df              	JR	NC,SKIPSP
  1466  047d  d607              	SUB	7
  1467  047f  e60f              HEX2:	AND	0FH
  1468  0481  eb                	EX	DE,HL
  1469  0482  29                	ADD	HL,HL
  1470  0483  29                	ADD	HL,HL
  1471  0484  29                	ADD	HL,HL
  1472  0485  29                	ADD	HL,HL
  1473  0486  eb                	EX	DE,HL
  1474  0487  b3                	OR	E
  1475  0488  5f                	LD	E,A
  1476  0489  23                	INC	HL
  1477  048a  18dd              	JR	HEX1
  1478                          ;
  1479                          ;OSCLI - Process an "operating system" command
  1480                          ;
  1481  048c  cd5c04            OSCLI:	CALL	SKIPSP
  1482  048f  fe0d              	CP	CR
  1483  0491  c8                	RET	Z
  1484  0492  fe7c              	CP	'|'
  1485  0494  c8                	RET	Z
  1486  0495  fe2e              	CP	'.'
  1487  0497  ca6705            	JP	Z,DOT		;*.
  1488  049a  fe2a              	CP	'*'
  1489  049c  2001              	JR	NZ,OSCLIC
  1490  049e  23                	INC	HL
  1491                          OSCLIC:
  1492  049f  eb                	EX	DE,HL
  1493  04a0  212f06            	LD	HL,COMDS ; OS command table
  1494  04a3  1a                OSCLI0:	LD	A,(DE)
  1495  04a4  cd0806            	CALL	UPPRC
  1496  04a7  be                	CP	(HL)
  1497  04a8  280c              	JR	Z,OSCLI2
  1498  04aa  da3805            	JP	C,HUH   ;END　OF　OS Command Table
  1499  04ad  cb7e              OSCLI1:	BIT	7,(HL)  ;　
  1500  04af  23                	INC	HL
  1501  04b0  28fb              	JR	Z,OSCLI1
  1502  04b2  23                	INC	HL
  1503  04b3  23                	INC	HL
  1504  04b4  18ed              	JR	OSCLI0
  1505                          ;
  1506  04b6  d5                OSCLI2:	PUSH	DE
  1507  04b7  13                OSCLI3:	INC	DE
  1508  04b8  23                	INC	HL
  1509  04b9  1a                	LD	A,(DE)
  1510  04ba  cd0806            	CALL	UPPRC
  1511  04bd  fe2e              	CP	'.'		;ABBREVIATED?
  1512  04bf  280a              	JR	Z,OSCLI4
  1513  04c1  ae                	XOR	(HL)
  1514  04c2  28f3              	JR	Z,OSCLI3
  1515  04c4  fe80              	CP	80H
  1516  04c6  2803              	JR	Z,OSCLI4
  1517  04c8  d1                	POP	DE
  1518  04c9  18e2              	JR	OSCLI1
  1519                          ;
  1520  04cb  f1                OSCLI4:	POP	AF
  1521  04cc  13                	INC	DE
  1522  04cd  cb7e              OSCLI5:	BIT	7,(HL)
  1523  04cf  23                	INC	HL
  1524  04d0  28fb              	JR	Z,OSCLI5
  1525  04d2  7e                	LD	A,(HL)
  1526  04d3  23                	INC	HL
  1527  04d4  66                	LD	H,(HL)
  1528  04d5  6f                	LD	L,A
  1529  04d6  e5                	PUSH	HL
  1530  04d7  eb                	EX	DE,HL
  1531  04d8  c35c04            	JP	SKIPSP
  1532                          ;
  1533                          ;
  1534  04db  cd5604            ERA:	CALL	SETUP0		;*ERA, *ERASE
  1535  04de  110000            	LD	DE,PATHBUF
  1536  04e1  0e4d              	LD	C,4DH		; _DELETE
  1537  04e3  cd0500            	CALL	BDOS
  1538  04e6  b7                	OR	A
  1539  04e7  c8                	RET	Z
  1540  04e8  c33805            	JP	HUH
  1541                          ;
  1542  04eb  0e0d              RES:	LD	C,13		;*RESET
  1543  04ed  cd0500            	CALL	BDOS
  1544  04f0  c9                	RET
  1545                          ;
  1546  04f1  cd5604            DRV:	CALL	SETUP0		;*DRIVE
  1547  04f4  3a0000            	LD	A,(PATHBUF)
  1548  04f7  cd0806            	CALL	UPPRC
  1549  04fa  d641              	SUB	'A'
  1550  04fc  da3805            	JP	C,HUH
  1551  04ff  5f                	LD	E,A
  1552  0500  0e0e              	LD	C,14
  1553  0502  cd0500            	CALL	BDOS
  1554  0505  c9                	RET
  1555                          ;
  1556  0506  cd5604            REN:	CALL	SETUP0		;*REN, *RENAME
