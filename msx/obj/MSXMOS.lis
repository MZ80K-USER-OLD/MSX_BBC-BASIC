    90                          IFNDEF BDOS
    91                          BDOS		EQU	$0005			; MSX-DOS API CALL
    92                          ENDIF
    93                          ;
    94                          ;
    95                          ;OSSAVE - Save an area of memory to a file.
    96                          ;   Inputs: HL addresses filename (term CR)
    97                          ;           DE = start address of data to save
    98                          ;           BC = length of data to save (bytes)
    99                          ; Destroys: A,B,C,D,E,H,L,F
   100                          ;
   101  0000  cd4905            STSAVE:	CALL	SAVLOD		;*SAVE
   102  0003  da3805            	JP	C,HUH		;"Bad command"
   103  0006  3a0000            	LD	A,(DOS_VER)
   104  0009  fe02              	CP	2
   105  000b  d24f01            	JP	NC,OSSAVE_DOS2
   106  000e  c34300            	JP	DOS2_REQUIRED
   107                          
   108                          #ifdef CPM
   109                          	PUSH	HL
   110                          	JR	OSS1
   111                          ;
   112                          OSSAVE:
   113                          	PUSH	BC		;SAVE
   114                          	CALL	SETUP0
   115                          OSS1:	EX	DE,HL
   116                          	CALL	CREATE
   117                          	JR	NZ,SAVE
   118                          DIRFUL:	LD	A,190
   119                          	CALL	EXTERR
   120                          	DEFM	"Directory full"
   121                          	DEFB	0
   122                          SAVE:	CALL	WRITE
   123                          	ADD	HL,BC
   124                          	EX	(SP),HL
   125                          	SBC	HL,BC
   126                          	EX	(SP),HL
   127                          	JR	Z,SAVE1
   128                          	JR	NC,SAVE
   129                          SAVE1:	POP	BC
   130                          CLOSE:	LD	A,16
   131                          	CALL	BDOS1
   132                          	INC	A
   133                          	RET	NZ
   134                          	LD	A,200
   135                          	CALL	EXTERR
   136                          	DEFM	"Close error"
   137                          	DEFB	0
   138                          #endif
   139                          ;
   140                          ; CHDIR - *CHDIR / *CD
   141                          ; HL = directory pathname terminated by CR
   142                          ;
   143                          CHDIR:
   144  0011  3a0000                LD      A,(DOS_VER)
   145  0014  fe02                  CP      2
   146  0016  da4300            	JP      C,DOS2_REQUIRED
   147                          
   148  0019  cd5c04                CALL    SKIPSP
   149                          
   150  001c  7e                    LD      A,(HL)
   151  001d  fe0d                  CP      CR
   152  001f  ca3805                JP      Z,HUH
   153                          
   154  0022  cdd303                CALL    PATHSAVE
   155  0025  cd0604                CALL    PATHNORM
   156                          
   157  0028  110000                LD      DE,PATHBUF
   158  002b  0e5a                  LD      C,5AH            ; MSX-DOS2 _CHDIR
   159  002d  cd0500                CALL    BDOS
   160                          
   161  0030  b7                    OR      A
   162  0031  c8                    RET     Z
   163                          
   164  0032  3eff                  LD      A,255
   165  0034  cd0000                CALL    EXTERR
   166  0037  4348444952206572      DEFM    "CHDIR error"
              726f72            
   167  0042  00                    DEFB    0
   168                          
   169                          DOS2_REQUIRED:
   170  0043  3eff                  LD      A,255
   171  0045  cd0000                CALL    EXTERR
   172  0048  4d53582d444f5332      DEFM    "MSX-DOS2 required"
              2072657175697265  
              64                
   173  0059  00                    DEFB    0
   174                          
   175                          ;
   176                          ;OSSHUT - Close disk file(s).
   177                          ;   Inputs: E = file channel
   178                          ;           If E=0 all files are closed (except SPOOL)
   179                          ; Destroys: A,B,C,D,E,H,L,F
   180                          ;
   181                          #ifdef CPM
   182                          OSSHUT:	LD	A,E
   183                          	OR	A
   184                          	JR	NZ,SHUTIT
   185                          SHUT0:	INC	E
   186                          	BIT	3,E
   187                          	RET	NZ
   188                          	PUSH	DE
   189                          	CALL	SHUT1
   190                          	POP	DE
   191                          	JR	SHUT0
   192                          ;
   193                          SHUTIT:	CALL	FIND1
   194                          	JR	NZ,SHUT2
   195                          	JP	CHANER
   196                          ;
   197                          SESHUT:	LD	HL,FLAGS
   198                          	RES	0,(HL)		;STOP EXEC
   199                          	RES	1,(HL)		;STOP SPOOL
   200                          	LD	E,8		;SPOOL/EXEC CHANNEL
   201                          SHUT1:	CALL	FIND1
   202                          	RET	Z
   203                          SHUT2:	XOR	A
   204                          	LD	(HL),A
   205                          	DEC	HL
   206                          	LD	(HL),A
   207                          	LD	HL,37
   208                          	ADD	HL,DE
   209                          	BIT	7,(HL)
   210                          	INC	HL
   211                          	CALL	NZ,WRITE
   212                          	LD	HL,FCBSIZ
   213                          	ADD	HL,DE
   214                          	LD	BC,(FREE)
   215                          	SBC	HL,BC
   216                          	JP	NZ,CLOSE
   217                          	LD	(FREE),DE	;RELEASE SPACE
   218                          	JP	CLOSE
   219                          #endif
   220                          ;
   221                          ;TYPE - *TYPE command.
   222                          ;Types file to console output.
   223                          ;
   224  005a  37                TYPE:	SCF			;*TYPE
   225  005b  cd3d02            	CALL	OSOPEN
   226  005e  b7                	OR	A
   227  005f  caaa03            	JP	Z,NOTFND
   228  0062  5f                	LD	E,A
   229  0063  3a0908            TYPE1:	LD	A,(FLAGS)	;TEST
   230  0066  cb7f              	BIT	7,A		;FOR
   231  0068  200b              	JR	NZ,TYPESC	;ESCape
   232  006a  cdd702            	CALL	OSBGET
   233  006d  cd6707            	CALL	OSWRCH		;N.B. CALLS "TEST"
   234  0070  30f1              	JR	NC,TYPE1
   235  0072  c39e02            	JP	OSSHUT
   236                          ;
   237  0075  cd9e02            TYPESC:	CALL	OSSHUT		;CLOSE!
   238  0078  c3eb06            	JP	ABORT
   239                          ;
   240                          ;OSLOAD - Load an area of memory from a file.
   241                          ;   Inputs: HL addresses filename (term CR)
   242                          ;           DE = address at which to load
   243                          ;           BC = maximum allowed size (bytes)
   244                          ;  Outputs: Carry reset indicates no room for file.
   245                          ; Destroys: A,B,C,D,E,H,L,F
   246                          ;
   247  007b  cd4905            STLOAD:	CALL	SAVLOD		;*LOAD
   248  007e  3a0000            	LD	A,(DOS_VER)
   249  0081  fe02              	CP	2
   250  0083  d29d00            	JP	NC,OSLOAD_DOS2
   251                          
   252                          #ifdef CPM
   253                          	PUSH	HL
   254                          	JR	OSL1
   255                          ;
   256                          OSLOAD:
   257                          OSLOAD_CPM:	PUSH	BC		;LOAD
   258                          	CALL	SETUP0
   259                          OSL1:	EX	DE,HL
   260                          	CALL	OPEN
   261                          	JR	NZ,LOAD0
   262                          NOTFND:	LD	A,214
   263                          	CALL	EXTERR
   264                          	DEFM	"File not found"
   265                          	DEFB	0
   266                          LOAD:	CALL	READ
   267                          	JR	NZ,LOAD1
   268                          	CALL	INCSEC
   269                          	ADD	HL,BC
   270                          LOAD0:	EX	(SP),HL
   271                          	SBC	HL,BC
   272                          	EX	(SP),HL
   273                          	JR	NC,LOAD
   274                          LOAD1:	POP	BC
   275                          	PUSH	AF
   276                          	CALL	CLOSE
   277                          	POP	AF
   278                          	CCF
   279                          OSCALL:	RET
   280                          #endif
   281                          
   282                          #ifndef CPM
   283                          OSSAVE:
   284  0086  3a0000            	LD	A,(DOS_VER)
   285  0089  fe02              	CP	2
   286  008b  da4300            	JP	C,DOS2_REQUIRED
   287  008e  c34f01            	JP	OSSAVE_DOS2
   288                          
   289                          OSLOAD:
   290  0091  3a0000            	LD	A,(DOS_VER)
   291  0094  fe02              	CP	2
   292  0096  da4300            	JP	C,DOS2_REQUIRED
   293  0099  c39d00            	JP	OSLOAD_DOS2
   294                          
   295                          OSCALL:
   296  009c  c9                	RET
   297                          #endif
   298                          
   299                          ;OSLOAD_DOS2 - Load through an MSX-DOS2 file handle.
   300                          ; _READ returns the actual byte count in HL.
   301                          ; Each read is limited to 512 bytes.
   302                          ;
   303                          OSLOAD_DOS2:
   304  009d  ed530000          	LD	(FILE_BUFADRS),DE
   305  00a1  ed430000          	LD	(FILE_MAXSIZE),BC
   306  00a5  cd5604            	CALL	SETUP0
   307  00a8  cd0604            	CALL	PATHNORM
   308  00ab  cd2904            	CALL	DOS2_DEFAULT_EXT
   309                          
   310  00ae  110000            	LD	DE,PATHBUF
   311  00b1  3e00              	LD	A,0			; read-only
   312  00b3  cdb401            	CALL	HOPEN
   313  00b6  b7                	OR	A
   314  00b7  c20201            	JP	NZ,FILE_DOS2_NOTFOUND
   315                          
   316                          LOAD_DOS2_LOOP:
   317  00ba  2a0000            	LD	HL,(FILE_MAXSIZE)
   318  00bd  7c                	LD	A,H
   319  00be  b5                	OR	L
   320  00bf  283c              	JR	Z,FILE_DOS2_CLOSE_OK
   321                          
   322  00c1  110001            	LD	DE,BLOCKSIZE
   323  00c4  b7                	OR	A
   324  00c5  ed52              	SBC	HL,DE
   325  00c7  3003              	JR	NC,LOAD_DOS2_FULL_BLOCK
   326  00c9  19                	ADD	HL,DE
   327  00ca  1803              	JR	LOAD_DOS2_HAVE_REQUEST
   328                          
   329                          LOAD_DOS2_FULL_BLOCK:
   330  00cc  210001            	LD	HL,BLOCKSIZE
   331                          LOAD_DOS2_HAVE_REQUEST:
   332  00cf  220000            	LD	(REQ_BYTES),HL
   333                          
   334  00d2  ed5b0000          	LD	DE,(FILE_BUFADRS)
   335  00d6  2a0000            	LD	HL,(REQ_BYTES)
   336  00d9  cddb01            	CALL	HREAD
   337  00dc  b7                	OR	A
   338  00dd  2052              	JR	NZ,FILE_DOS2_ERROR
   339  00df  7c                	LD	A,H
   340  00e0  b5                	OR	L
   341  00e1  281a              	JR	Z,FILE_DOS2_CLOSE_OK
   342                          
   343  00e3  ed530000          	LD	(FILE_BUFADRS),DE
   344  00e7  eb                	EX	DE,HL
   345  00e8  2a0000            	LD	HL,(FILE_MAXSIZE)
   346  00eb  b7                	OR	A
   347  00ec  ed52              	SBC	HL,DE
   348  00ee  3841              	JR	C,FILE_DOS2_ERROR
   349  00f0  220000            	LD	(FILE_MAXSIZE),HL
   350                          
   351  00f3  2a0000            	LD	HL,(REQ_BYTES)
   352  00f6  b7                	OR	A
   353  00f7  ed52              	SBC	HL,DE
   354  00f9  3836              	JR	C,FILE_DOS2_ERROR
   355  00fb  28bd              	JR	Z,LOAD_DOS2_LOOP
   356                          FILE_DOS2_CLOSE_OK:
   357  00fd  cdd101            	CALL	HCLOSE
   358  0100  37                	SCF
   359  0101  c9                	RET
   360                          
   361                          FILE_DOS2_NOTFOUND:
   362  0102  3ed6              	LD	A,214
   363  0104  cd0000            	CALL	EXTERR
   364  0107  46696c65206e6f74  	DEFM	"File not found"
              20666f756e64      
   365  0115  00                	DEFB	0
   366                          
   367                          FILE_DOS2_CREATE_ERROR:
   368  0116  3eff              	LD	A,255
   369  0118  cd0000            	CALL	EXTERR
   370  011b  4d53582d444f5332  	DEFM	"MSX-DOS2 create error"
              2063726561746520  
              6572726f72        
   371  0130  00                	DEFB	0
   372                          
   373                          FILE_DOS2_ERROR:
   374  0131  f5                	PUSH	AF
   375  0132  cdd101            	CALL	HCLOSE
   376  0135  f1                	POP	AF
   377  0136  3eff              	LD	A,255
   378  0138  cd0000            	CALL	EXTERR
   379  013b  4d53582d444f5332  	DEFM	"MSX-DOS2 file error"
              2066696c65206572  
              726f72            
   380  014e  00                	DEFB	0
   381                          
   382                          ;
   383                          ;OSSAVE_DOS2 - Save through an MSX-DOS2 file handle.
   384                          ; _WRITE returns the actual byte count in HL.
   385                          ; Each write is limited to 512 bytes.
   386                          ;  DE=FILE BUFFER
   387                          ;  BC=FILE SIZE (bytes)
   388                          OSSAVE_DOS2:
   389  014f  ed530000          	LD	(FILE_BUFADRS),DE
   390  0153  ed430000          	LD	(FILE_MAXSIZE),BC
   391  0157  cd5604            	CALL	SETUP0
   392  015a  cd0604            	CALL	PATHNORM
   393  015d  cd2904            	CALL	DOS2_DEFAULT_EXT
   394                          
   395  0160  110000            	LD	DE,PATHBUF
   396  0163  cdc201            	CALL	HCREATE
   397  0166  b7                	OR	A
   398  0167  c21601            	JP	NZ,FILE_DOS2_CREATE_ERROR
   399                          SAVE_DOS2_LOOP:
   400  016a  2a0000            	LD	HL,(FILE_MAXSIZE)   ;FILE remaining size
   401  016d  7c                	LD	A,H
   402  016e  b5                	OR	L
   403  016f  288c              	JR	Z,FILE_DOS2_CLOSE_OK
   404                          
   405  0171  110001            	LD	DE,BLOCKSIZE
   406  0174  b7                	OR	A
   407  0175  ed52              	SBC	HL,DE
   408  0177  3003              	JR	NC,SAVE_DOS2_FULL_BLOCK	; BLOCK SIZE WRITE
   409  0179  19                	ADD	HL,DE
   410  017a  1803              	JR	SAVE_DOS2_SIZE; short block write
   411                          
   412                          SAVE_DOS2_FULL_BLOCK:
   413  017c  210001            	LD	HL,BLOCKSIZE	; full block write
   414                          
   415                          SAVE_DOS2_SIZE:
   416  017f  220000            	LD	(REQ_BYTES),HL
   417  0182  ed5b0000          	LD	DE,(FILE_BUFADRS)
   418  0186  2a0000            	LD	HL,(REQ_BYTES)
   419  0189  cdfd01            	CALL	HWRITE
   420  018c  b7                	OR	A
   421  018d  c23101            	JP	NZ,FILE_DOS2_ERROR
   422  0190  7c                	LD	A,H
   423  0191  b5                	OR	L
   424  0192  cafd00            	JP	Z,FILE_DOS2_CLOSE_OK
   425                          
   426  0195  ed530000          	LD	(FILE_BUFADRS),DE
   427  0199  eb                	EX	DE,HL
   428  019a  2a0000            	LD	HL,(FILE_MAXSIZE)
   429  019d  b7                	OR	A
   430  019e  ed52              	SBC	HL,DE
   431  01a0  da3101            	JP	C,FILE_DOS2_ERROR
   432  01a3  220000            	LD	(FILE_MAXSIZE),HL
   433                          
   434  01a6  2a0000            	LD	HL,(REQ_BYTES)
   435  01a9  b7                	OR	A
   436  01aa  ed52              	SBC	HL,DE
   437  01ac  da3101            	JP	C,FILE_DOS2_ERROR	;
   438  01af  28b9              	JR	Z,SAVE_DOS2_LOOP
   439  01b1  c3fd00            	JP	FILE_DOS2_CLOSE_OK	; short read means EOF
   440                          
   441                          
   442                          ; HOPEN - Open an MSX-DOS2 file.
   443                          ;   Inputs: DE = ASCIIZ filename, A = access mode
   444                          ;  Outputs: A = error code (0 on success), FILE_HANDLE = file handle
   445                          ; Destroys: A,C,DE,HL,F
   446                          HOPEN:
   447  01b4  47                	LD	B,A			; _OPEN access mode
   448  01b5  0e43              	LD	C,43H			; _OPEN
   449  01b7  cd0500            	CALL	BDOS
   450  01ba  b7                	OR	A
   451  01bb  c0                	RET	NZ
   452  01bc  78                	LD	A,B
   453  01bd  320000            	LD	(FILE_HANDLE),A
   454  01c0  af                	XOR	A
   455  01c1  c9                	RET
   456                          
   457                          ; HCREATE - Create/truncate an MSX-DOS2 file.
   458                          ;   Inputs: DE = ASCIIZ filename
   459                          ;  Outputs: A = error code (0 on success), FILE_HANDLE = file handle
   460                          ;  Destroys: A,B,C,DE,HL,F
   461                          HCREATE:
   462  01c2  0600              	LD	B,0			; normal file attribute
   463  01c4  0e44              	LD	C,44H			; _CREATE
   464  01c6  cd0500            	CALL	BDOS
   465  01c9  b7                	OR	A
   466  01ca  c0                	RET	NZ
   467  01cb  78                	LD	A,B
   468  01cc  320000            	LD	(FILE_HANDLE),A
   469  01cf  af                	XOR	A
   470  01d0  c9                	RET
   471                          
   472                          ; HCLOSE - Close an MSX-DOS2 file handle.
   473                          ;   Inputs: FILE_HANDLE = file handle
   474                          ;  Outputs: A = error code (0 on success)
   475                          ; Destroys: A,BC,DE,HL,F
   476                          HCLOSE:
   477  01d1  3a0000            	LD	A,(FILE_HANDLE)
   478  01d4  47                	LD	B,A
   479  01d5  0e45              	LD	C,45H			; _CLOSE
   480  01d7  cd0500            	CALL	BDOS
   481  01da  c9                	RET
   482                          
   483                          ; HREAD - Read bytes through an MSX-DOS2 file handle.
   484                          ;   Inputs: FILE_HANDLE = file handle, DE = destination buffer,
   485                          ;           HL = requested bytes
   486                          ;  Outputs: A = error code (0 on success), DE = next buffer address,
   487                          ;           HL = actual bytes read returned by _READ
   488                          ; Destroys: A,BC,F
   489                          HREAD:
   490  01db  ed530000          	LD	(FILE_BUFADRS),DE
   491  01df  220000            	LD	(REQ_BYTES),HL
   492  01e2  3a0000            	LD	A,(FILE_HANDLE)
   493  01e5  47                	LD	B,A
   494  01e6  ed5b0000          	LD	DE,(FILE_BUFADRS)
   495  01ea  2a0000            	LD	HL,(REQ_BYTES)
   496  01ed  0e48              	LD	C,48H			; _READ
   497  01ef  cd0500            	CALL	BDOS
   498  01f2  b7                	OR	A
   499  01f3  c0                	RET	NZ
   500  01f4  ed5b0000          	LD	DE,(FILE_BUFADRS)
   501  01f8  e5                	PUSH	HL
   502  01f9  19                	ADD	HL,DE
   503  01fa  eb                	EX	DE,HL
   504  01fb  e1                	POP	HL
   505  01fc  c9                	RET
   506                          ;
   507                          ; HWRITE - Write bytes through an MSX-DOS2 file handle.
   508                          ;   Inputs: FILE_HANDLE = file handle,
   509                          ;           DE = source buffer,
   510                          ;           HL = requested bytes
   511                          ;  Outputs: A = error code (0 on success),
   512                          ;           DE = next buffer address,
   513                          ;           HL = actual bytes written returned by _WRITE
   514                          ; Destroys: A,BC,F
   515                          HWRITE:
   516  01fd  3a0000            	LD	A,(FILE_HANDLE)
   517  0200  47                	LD	B,A
   518  0201  0e49              	LD	C,49H			; _WRITE
   519  0203  d5                	PUSH DE
   520  0204  cd0500            	CALL	BDOS
   521  0207  d1                	POP DE
   522  0208  b7                	OR	A
   523  0209  c0                	RET	NZ
   524  020a  e5                	PUSH	HL
   525  020b  19                	ADD	HL,DE
   526  020c  eb                	EX	DE,HL
   527  020d  e1                	POP	HL
   528  020e  c9                	RET
