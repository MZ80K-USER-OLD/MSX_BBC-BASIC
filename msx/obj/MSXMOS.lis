  2010  074b  3600              	LD	(HL),0
  2011  074d  e1                	POP	HL
  2012  074e  b7                	OR	A
  2013  074f  37                	SCF
  2014  0750  c0                	RET	NZ
  2015  0751  d5                	PUSH	DE
  2016  0752  cd0000            	CALL	GETKEY
  2017  0755  d1                	POP	DE
  2018  0756  d0                	RET	NC
  2019  0757  fe1b              	CP	ESC
  2020  0759  37                	SCF
  2021  075a  c0                	RET	NZ
