  1558  050b  202b              	JR	NZ,HUH
  1559  050d  23                	INC	HL		;SKIP "="
  1560  050e  e5                	PUSH	HL
  1561  050f  210000            	LD	HL,PATHBUF
  1562  0512  110000            	LD	DE,PATHBUF2
  1563  0515  7e                REN1:	LD	A,(HL)
  1564  0516  12                	LD	(DE),A
  1565  0517  23                	INC	HL
  1566  0518  13                	INC	DE
