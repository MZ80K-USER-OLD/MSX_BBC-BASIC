   530                          #ifndef CPM
   531                          ;
   532                          ; MSX-DOS2 channel implementation.  BASIC channels 1-7 are available to
   533                          ; OPENIN/OPENOUT/OPENUP; channel 8 is reserved for SPOOL and EXEC.
   534                          ;
   535                          DOS2_FIND:
   536  020f  7b                	LD	A,E
   537  0210  b7                	OR	A
   538  0211  ca2802            	JP	Z,DOS2_CHANER
   539  0214  fe09              	CP	9
   540  0216  d22802            	JP	NC,DOS2_CHANER
   541  0219  1600              	LD	D,0
   542  021b  210000            	LD	HL,DOS2_HANDLES
   543  021e  19                	ADD	HL,DE
   544  021f  7e                	LD	A,(HL)
   545  0220  b7                	OR	A
   546  0221  ca2802            	JP	Z,DOS2_CHANER
   547  0224  320000            	LD	(FILE_HANDLE),A
   548  0227  c9                	RET
   549                          
   550                          DOS2_CHANER:
   551  0228  3ede              	LD	A,222
   552  022a  cd0000            	CALL	EXTERR
   553  022d  496e76616c696420  	DEFM	"Invalid channel"
              6368616e6e656c    
   554  023c  00                	DEFB	0
   555                          
   556                          ; OSOPEN - open a DOS2 file and return a BASIC file channel.
   557                          OSOPEN:
   558  023d  f5                	PUSH	AF
   559  023e  cdd303            	CALL	PATHSAVE
   560  0241  cd0604            	CALL	PATHNORM
   561  0244  cd2904            	CALL	DOS2_DEFAULT_EXT
   562  0247  1e01              	LD	E,1
   563                          DOS2_OPEN_SLOT:
   564  0249  1600              	LD	D,0
   565  024b  210000            	LD	HL,DOS2_HANDLES
   566  024e  19                	ADD	HL,DE
   567  024f  7e                	LD	A,(HL)
   568  0250  b7                	OR	A
   569  0251  2820              	JR	Z,DOS2_OPEN_FILE
   570  0253  1c                	INC	E
   571  0254  7b                	LD	A,E
   572  0255  fe08              	CP	8
   573  0257  38f0              	JR	C,DOS2_OPEN_SLOT
   574  0259  f1                	POP	AF
   575  025a  3ec0              	LD	A,192
   576  025c  cd0000            	CALL	EXTERR
   577  025f  546f6f206d616e79  	DEFM	"Too many open files"
              206f70656e206669  
              6c6573            
   578  0272  00                	DEFB	0
   579                          DOS2_OPEN_FILE:
   580  0273  f1                	POP	AF
   581  0274  d5                	PUSH	DE
   582  0275  110000            	LD	DE,PATHBUF
   583  0278  3805              	JR	C,DOS2_OPEN_READ
   584  027a  cdc201            	CALL	HCREATE
   585  027d  1805              	JR	DOS2_OPEN_RESULT
   586                          DOS2_OPEN_READ:
   587  027f  3e00              	LD	A,0
   588  0281  cdb401            	CALL	HOPEN
   589                          DOS2_OPEN_RESULT:
   590  0284  d1                	POP	DE
   591  0285  b7                	OR	A
   592  0286  2802              	JR	Z,DOS2_OPEN_OK
   593  0288  af                	XOR	A
   594  0289  c9                	RET
   595                          DOS2_OPEN_OK:
   596  028a  210000            	LD	HL,DOS2_HANDLES
   597  028d  1600              	LD	D,0
   598  028f  19                	ADD	HL,DE
   599  0290  3a0000            	LD	A,(FILE_HANDLE)
   600  0293  77                	LD	(HL),A
   601  0294  210000            	LD	HL,DOS2_EOF
   602  0297  19                	ADD	HL,DE
   603  0298  3600              	LD	(HL),0
   604  029a  7b                	LD	A,E
   605  029b  c30000            	JP	CHECK
