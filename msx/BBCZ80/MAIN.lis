  2119                          ;LEXAN - LEXICAL ANALYSIS.
  2120                          ;  Bit 0,C: 1=left, 0=right
  2121                          ;  Bit 3,C: 1=in HEX
  2122                          ;  Bit 4,C: 1=accept line number
  2123                          ;  Bit 5,C: 1=in variable, FN, PROC
  2124                          ;  Bit 6,C: 1=in REM, DATA, *
  2125                          ;  Bit 7,C: 1=in quotes
