  2110                          ;LEXAN - LEXICAL ANALYSIS.
  2111                          ;  Bit 0,C: 1=left, 0=right
  2112                          ;  Bit 3,C: 1=in HEX
  2113                          ;  Bit 4,C: 1=accept line number
  2114                          ;  Bit 5,C: 1=in variable, FN, PROC
  2115                          ;  Bit 6,C: 1=in REM, DATA, *
  2116                          ;  Bit 7,C: 1=in quotes
  2117                          ;   Inputs: IY addresses source string
  2118                          ;           DE addresses destination string
  2119                          ;           (must be page boundary)
  2120                          ;           C  sets initial mode
  2121                          ;  Outputs: DE, IY updated
  2122                          ;           A holds carriage return
  2123                          ;
