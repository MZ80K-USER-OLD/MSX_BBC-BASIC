../BBCZ80/DIST.asm:
     1                          ;	TITLE	BBCDIST.Z80 (C) R.T.RUSSELL 1982-2024
     2                          ;
     3                          ;BBC BASIC (Z80) - CP/M VERSION 2.20 & 3.00
     4                          ;(C) COPYRIGHT R.T.RUSSELL, 1982-2024.
     5                          ;ALL RIGHTS RESERVED.
     6                          ;
     7                          ;THIS PROGRAM ALLOWS THE USER TO ADAPT BBC BASIC TO THE
     8                          ;PARTICULAR CHARACTERISTICS OF HIS SYSTEM HARDWARE ETC.
     9                          ;
    10                          ;THE PROGRAM RESIDES AT 100H FOR EASE OF LOADING.
    11                          ;*** IT MUST NOT EXCEED 256 BYTES IN TOTAL LENGTH ***
    12                          ;
    13                          ;PLEASE NOTE THAT A Z80 PROCESSOR AND CP/M VERSION 2.2
    14                          ;OR LATER ARE REQUIRED.
    15                          ;
    16                          ;R.T.RUSSELL, 11-03-1984, 03-05-1989, 12-05-2024
    17                          ;
    18                          CPM	EQU	5
    19                          
    20                          
    21                          	SECTION  DIST
    22                          
    23                          ;COLD	EQU	200H
    24                          ;
    25                          	GLOBAL	CLRSCN
    26                          	GLOBAL	PUTCSR
    27                          	GLOBAL	GETCSR
    28                          	GLOBAL	PUTIME
    29                          	GLOBAL	GETIME
    30                          	GLOBAL	GETKEY
    31                          	GLOBAL	BYE
    32                          ;	MAIN
    33                          	EXTERN	COLD
    34                          	EXTERN	OSCLI
    35                          	EXTERN	OSBGET
    36                          	EXTERN	OSBPUT
    37                          	EXTERN	OSSTAT
    38                          	EXTERN	OSSHUT
    39                          	EXTERN	OSVERCHK
    40                          	EXTERN	OSGETTICK
    41                          
    42                          
    43                          	ORG	100H
    44                          ;
    45                          ;JUMP TABLE - BASIC makes calls to hardware-dependent
    46                          ;features via this table:
    47                          ;
    48  0000  c32400            INIT0:	JP	INIT	;INITIALISE HARDWARE
    49  0003  c37d00            CLRSCN:	JP	CLS		;CLEAR SCREEN
    50  0006  c37e00            PUTCSR:	JP	PCSR	;SET CURSOR POSN.
    51  0009  c37f00            GETCSR:	JP	GCSR	;READ CURSOR POSN.
    52  000c  c33e00            PUTIME:	JP	PTIME	;SET ELAPSED TIME
    53  000f  c32b00            GETIME:	JP	GTIME	;READ ELAPSED TIME
    54  0012  c35b00            GETKEY:	JP	INKEY	;READ KEY (TIME LIMIT)
    55  0015  c32a00            BYE:	JP	REBOOT	;RETURN TO CP/M
    56                          
    57                          ;
    58                          ;BDOS	- Save the IX and IY registers and before performing a
    59                          ;	  CP/M function call.
    60                          ;
    61  0018  dde5              BDOS:	PUSH	IX
    62  001a  fde5              	PUSH	IY
    63  001c  cd0500            	CALL	CPM
    64  001f  fde1              	POP	IY
    65  0021  dde1              	POP	IX
    66  0023  c9                	RET
    67                          ;
    68                          ;INIT	- Perform hardware initialisation (if any).
    69                          ;
    70                          INIT:
    71  0024  cd0000            	CALL OSVERCHK;	OS ROM version check
    72  0027  c30000            	JP COLD
    73                          
    74  002a  c7                REBOOT:	RST	0
    75                          ;
    76                          ;GTIME	- Read elapsed-time clock.
    77                          ;  	  Outputs: DEHL = elapsed time (centiseconds)
    78                          ; 	  Destroys: A,D,E,H,L,F
    79                          ;
    80  002b  c5                GTIME:	PUSH	BC
    81  002c  cd5700            	CALL	TICKS
    82  002f  ed4b0000          	LD	BC,(OFFLO)
    83  0033  09                	ADD	HL,BC
    84  0034  eb                	EX	DE,HL
    85  0035  ed4b0200          	LD	BC,(OFFHI)
    86  0039  ed4a              	ADC	HL,BC
    87  003b  eb                	EX	DE,HL
    88  003c  c1                	POP	BC
    89  003d  c9                	RET
    90                          ;
    91                          ;PTIME	- Load elapsed-time clock.
    92                          ;   	  Inputs: DEHL = time to load (centiseconds)
    93                          ; 	  Destroys: A,D,E,H,L,F
    94                          ;
    95  003e  c5                PTIME:	PUSH	BC
    96  003f  d5                	PUSH	DE
    97  0040  e5                	PUSH	HL
    98  0041  cd5700            	CALL	TICKS
    99  0044  44                	LD	B,H
   100  0045  4d                	LD	C,L
   101  0046  e1                	POP	HL
   102  0047  b7                	OR	A
   103  0048  ed42              	SBC	HL,BC
   104  004a  220000            	LD	(OFFLO),HL
   105  004d  42                	LD	B,D
   106  004e  4b                	LD	C,E
   107  004f  e1                	POP	HL
   108  0050  ed42              	SBC	HL,BC
   109  0052  220200            	LD	(OFFHI),HL
   110  0055  c1                	POP	BC
   111  0056  c9                	RET
   112                          ;
   113                          ; Get OS elapsed-time clock
   114                          ;  Outputs: DEHL = time (centiseconds)
   115                          ; Destroys: A,B,C,D,E,H,L,F
   116                          ;
   117                          TICKS:
   118  0057  cd0000            	CALL OSGETTICK
   119  005a  c9                	RET
   120                          ;
   121                          ;INKEY	- Sample keyboard with specified wait.
   122                          ;   	  Inputs: HL = Time to wait (centiseconds)
   123                          ;  	  Outputs: Carry reset indicates time-out.
   124                          ;                  If carry set, A = character typed.
   125                          ; 	  Destroys: A,D,E,H,L,F
   126                          ;
   127  005b  c5                INKEY:	PUSH	BC
   128  005c  e5                	PUSH	HL
   129  005d  cd5700            	CALL	TICKS
   130  0060  d1                	POP	DE
   131  0061  19                	ADD	HL,DE
   132  0062  e5                WAIT:	PUSH	HL
   133  0063  0e06              	LD	C,6
   134  0065  1eff              	LD	E,0FFH
   135  0067  cd1800            	CALL	BDOS
   136  006a  e1                	POP	HL
   137  006b  b7                	OR	A
   138  006c  37                	SCF
   139  006d  c27b00            	JP	NZ,INKEY1
   140  0070  e5                	PUSH	HL
   141  0071  cd5700            	CALL	TICKS
   142  0074  d1                	POP	DE
   143  0075  ed52              	SBC	HL,DE
   144  0077  eb                	EX	DE,HL
   145  0078  da6200            	JP	C,WAIT
   146  007b  c1                INKEY1:	POP	BC
   147  007c  c9                	RET
   148                          ;
   149                          ;CLS	- Clear screen.
   150                          ;	  (Customise to suit your VDU)
   151                          ; 	  Destroys: A,D,E,H,L,F
   152                          ;
   153  007d  c9                CLS:	RET
   154                          ;
   155                          ;PCSR	- Move cursor to specified position.
   156                          ;   	  Inputs: DE = horizontal position (LHS=0)
   157                          ;                 HL = vertical position (TOP=0)
   158                          ; 	  Destroys: A,D,E,H,L,F
   159                          ;
   160  007e  c9                PCSR:	RET
   161                          ;
   162                          ;GCSR	- Return cursor coordinates.
   163                          ;   	  Outputs:  DE = X coordinate (POS)
   164                          ;                   HL = Y coordinate (VPOS)
   165                          ;  	  Destroys: A,D,E,H,L,F
   166                          ;
   167  007f  110000            GCSR:	LD	DE,0
   168  0082  210000            	LD	HL,0
   169  0085  c9                	RET
   170                          ;
   171                          ;COUT - Output a character to the console
   172                          ;   Inputs: A = character
   173                          ; Destroys: A,F
   174                          ;
   175  0086  c5                COUT:	PUSH	BC
   176  0087  d5                	PUSH	DE
   177  0088  e5                	PUSH	HL
   178  0089  5f                	LD	E,A
   179  008a  0e02              	LD	C,2
   180  008c  cd1800            	CALL	BDOS
   181  008f  e1                	POP	HL
   182  0090  d1                	POP	DE
   183  0091  c1                	POP	BC
   184  0092  c9                	RET
   185                          
   186                          
   187                          ;
   188                          	IF	$ >  1F0H
   189                          	ERROR	"INSUFFICIENT SPACE"
   190                          	ENDIF
   191                          ;
   192                          	SECTION TERMSEG
   193                          	ORG 01F0H
   194                          ;
   195  0000  0000              OFFLO:		DEFW	0		;TIME OFFSET LO
   196  0002  0000              OFFHI:		DEFW	0		;TIME OFFSET HI
   197  0004  50                WIDTH:		DEFB	80		;WIDTH
   198  0005  07                CURUP:		DEFB	'G' & 1FH	;CURSOR UP
   199  0006  0f                CURDOWN:	DEFB	'O' & 1FH	;CURSOR DOWN
   200  0007  06                CURHOME:	DEFB	'F' & 1FH	;START OF LINE
   201  0008  0e                CUREND:		DEFB	'N' & 1FH	;END OF LINE
   202  0009  18                DELLINE:	DEFB	'X' & 1FH	;DELETE TO END OF LINE
   203  000a  08                BACKSP:		DEFB	08H		;BACKSPACE & DELETE
   204  000b  15                DELTOST:	DEFB	'U' & 1FH	;DEL TO START OF LINE
   205  000c  0a                CURLEFT:	DEFB	'J' & 1FH	;CURSOR LEFT
   206  000d  0c                CURRIGHT:	DEFB	'L' & 1FH	;CURSOR RIGHT
   207  000e  12                DELCHR:		DEFB	'R' & 1FH	;DELETE CHARACTER
   208  000f  11                INSCHR:		DEFB	'Q' & 1FH	;INS/OVR TOGGLE
   209                          ;
   210                          FIN:	;END
   211                          
