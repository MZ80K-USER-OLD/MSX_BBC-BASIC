  3169  12d5  fd7e00            	LD	A,(IY)
  3170  12d8  fedc              	CP	TDATA
  3171  12da  20d0              	JR	NZ,WSRCH
  3172  12dc  fd7e00            WSRCHM:	LD	A,(IY)
  3173  12df  fd23              	INC	IY
  3174  12e1  fe0d              	CP	CR
  3175  12e3  20f7              	JR	NZ,WSRCHM		;Skip to end of line
  3176  12e5  18e1              	JR	WSRCH1
