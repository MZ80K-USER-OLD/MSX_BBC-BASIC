   272                          ;
   273                          TLAST	EQU	TCMD-128+($-CMDTAB)/2
   274                          ;
   275  00a2  cdc011            RUN:	CALL	TERMQ
   276  00a5  280d              	JR	Z,RUN0
   277  00a7  cd0000            CHAIN:	CALL	EXPRS
   278  00aa  3e0d              	LD	A,CR
   279  00ac  12                	LD	(DE),A
   280  00ad  ed7b0000          CHAIN0:	LD	SP,(HIMEM)
   281  00b1  cd0000            	CALL	LOAD0
   282  00b4  ed7b0000          RUN0:	LD	SP,(HIMEM)	;PREPARE FOR RUN
   283  00b8  dd210000          	LD	IX,RANDOM
   284                          ;	Original code used the Z80 refresh register as a seed, but this can
   285                          ;	hang if R is not incremented correctly on some MSX hardware/cores:
   286                          ;RAND:	LD	A,R		;RANDOMISE (CARE!)
   287                          ;	JR	Z,RAND
   288                          ;
   289                          ;	LD	A,(0FC9EH)	;JIFFY - MSX VBLANK COUNTER (avoids R register)
   290                          RAND:
   291  00bc  ed5f              	LD A,R
   292  00be  b7                	OR A
   293  00bf  28fb              	JR Z,RAND
   294  00c1  07                	RLCA
   295  00c2  07                	RLCA
   296  00c3  dd7703            	LD	(IX+3),A
   297  00c6  9f                	SBC	A,A
   298  00c7  dd7704            	LD	(IX+4),A
   299  00ca  cd0000            	CALL	CLEAR
   300  00cd  210000            	LD	HL,0
   301  00d0  220000            	LD	(ERRTRP),HL
   302  00d3  2a0000            	LD	HL,(PAGE)
   303  00d6  cd8312            	CALL	DSRCH		;LOOK FOR "DATA"
   304  00d9  220000            	LD	(DATPTR),HL	;SET DATA POINTER
   305  00dc  fd2a0000          	LD	IY,(PAGE)
   306  00e0  cd4801            XEQ0:	CALL	NEWLIN
   307  00e3  fd7e00            	LD	A,(IY)
   308  00e6  fe8b              	CP	TELSE
   309  00e8  ca9d09            	JP	Z,MELSE		;ELSE
   310  00eb  fec9              	CP	TWHEN
   311  00ed  cab009            	JP	Z,WHEN		;WHEN
   312  00f0  fecc              	CP	TOTHERWISE
   313  00f2  cab009            	JP	Z,WHEN
   314  00f5  fd220000          XEQ:	LD	(CURLIN),IY	;ERROR POINTER
   315  00f9  cd0000            	CALL	TRAP		;CHECK KEYBOARD
   316  00fc  cd0000            XEQ1:	CALL	NXT
   317  00ff  fd23              	INC	IY
   318  0101  fe3a              	CP	':'		;SEPARATOR
   319  0103  28f7              	JR	Z,XEQ1
   320  0105  fe0d              	CP	CR
   321  0107  28d7              	JR	Z,XEQ0		;NEW PROGRAM LINE
   322  0109  fee6              	CP	TSPRITE_PREFIX
   323  010b  200d              	JR	NZ,XEQ2
   324  010d  fd7e00            	LD	A,(IY)
   325  0110  fd23              	INC	IY
   326  0112  fe01              	CP	TSPRITE_SUB
   327  0114  ca300e            	JP	Z,SPRITE
   328  0117  c34d02            	JP	SYNTAX
   329                          XEQ2:
   330  011a  fe91              	CP	TLAST
   331  011c  ea0102            	JP	PE,LET0		;IMPLIED LET
   332  011f  d6c0              	SUB	TCMD
   333  0121  fa8401            	JP	M,EXTRAS
   334  0124  87                	ADD	A,A
   335  0125  4f                	LD	C,A
   336  0126  0600              	LD	B,0
   337  0128  210000            	LD	HL,CMDTAB
   338  012b  09                	ADD	HL,BC
   339  012c  7e                	LD	A,(HL)		;TABLE ENTRY
   340  012d  23                	INC	HL
   341  012e  66                	LD	H,(HL)
   342  012f  6f                	LD	L,A
   343  0130  cd0000            	CALL	NXT
   344  0133  e9                	JP	(HL)		;EXECUTE STATEMENT
   345                          ;
   346                          ;END
   347                          ;
   348  0134  fde5              ENDIM:	PUSH	IY
   349  0136  e1                	POP	HL
   350  0137  ed4b0000          	LD	BC,(PAGE)
   351  013b  ed42              	SBC	HL,BC		;IMMEDIATE MODE ?
   352  013d  da0000            	JP	C,CLOOP
   353  0140  1e00              END:	LD	E,0
   354  0142  cd0000            	CALL	OSSHUT		;CLOSE ALL FILES
   355  0145  c30000            	JP	WARM		;"Ready"
   356                          ;
   357  0148  fd7e00            NEWLIN:	LD	A,(IY+0)	;A=LINE LENGTH
   358  014b  010300            	LD	BC,3
   359  014e  fd09              	ADD	IY,BC
   360  0150  b7                	OR	A
   361  0151  28e1              	JR	Z,ENDIM		;LENGTH=0, EXIT
   362  0153  2a0000            	LD	HL,(TRACEN)
   363  0156  7c                	LD	A,H
   364  0157  b5                	OR	L
   365  0158  c8                	RET	Z
   366  0159  fd56ff            	LD	D,(IY-1)	;DE = LINE NUMBER
   367  015c  fd5efe            	LD	E,(IY-2)
   368  015f  ed52              	SBC	HL,DE
   369  0161  d8                	RET	C
   370  0162  eb                	EX	DE,HL
   371  0163  3e5b              	LD	A,'['		;TRACE
   372  0165  cd0000            	CALL	OUTCHR
   373  0168  cd0000            	CALL	PBCDL
   374  016b  3e5d              	LD	A,']'
   375  016d  cd0000            	CALL	OUTCHR
   376  0170  3e20              	LD	A,' '
   377  0172  c30000            	JP	OUTCHR
   378                          ;
   379                          ;ROUTINES FOR EACH STATEMENT:
   380                          ;
   381                          ;OSCLI
   382                          ;
   383  0175  cd0000            CLI:	CALL	EXPRS
   384  0178  3e0d              	LD	A,CR
   385  017a  12                	LD	(DE),A
   386  017b  210000            	LD	HL,ACCS
   387  017e  cd0000            	CALL	OSCLI
   388  0181  c3f500            	JP	XEQ
   389                          ;
   390  0184  fecb              EXTRAS:	CP	TELSE-TCMD
   391  0186  2817              	JR	Z,REM		;ELSE
   392  0188  fec5              	CP	TERROR-TCMD
   393  018a  2821              	JR	Z,THROW		;ERROR
   394  018c  fec6              	CP	TLINE-TCMD
   395  018e  ca0000            	JP	Z,LINE		;LINE
   396  0191  fec7              	CP	TOFF-TCMD
   397  0193  ca0000            	JP	Z,CSROFF	;OFF
   398  0196  c34d02            	JP	SYNTAX
   399                          ;
   400                          ;REM, *
   401                          ;
   402  0199  fde5              EXT:	PUSH	IY
   403  019b  e1                	POP	HL
   404  019c  cd0000            	CALL	OSCLI
   405  019f  fde5              REM:	PUSH	IY
   406  01a1  e1                	POP	HL
   407  01a2  3e0d              	LD	A,CR
   408  01a4  47                	LD	B,A
   409  01a5  edb1              	CPIR			;FIND LINE END
   410  01a7  e5                	PUSH	HL
   411  01a8  fde1              	POP	IY
   412  01aa  c3e000            	JP	XEQ0
   413                          ;
   414                          ;ERROR num,string$
   415                          ;
   416  01ad  cd0000            THROW:	CALL	EXPRI
   417  01b0  d9                	EXX
   418  01b1  e5                	PUSH	HL
   419  01b2  d9                	EXX
   420  01b3  cd0000            	CALL	COMMA
   421  01b6  cd0000            	CALL	EXPRS
   422  01b9  e1                	POP	HL
   423  01ba  af                	XOR	A
   424  01bb  12                	LD	(DE),A
   425  01bc  7d                	LD	A,L
   426  01bd  210000            	LD	HL,ACCS
   427  01c0  110000            	LD	DE,BUFFER
   428  01c3  d5                	PUSH	DE
   429  01c4  010001            	LD	BC,256
   430  01c7  edb0              	LDIR
   431  01c9  c30000            	JP	EXTERR
   432                          ;
   433                          ; SWAP
   434                          ;
   435  01cc  cd0000            SWAP:	CALL	GETVAR
   436  01cf  200b              	JR	NZ,SWAPNZ
   437  01d1  f5                	PUSH	AF
   438  01d2  e5                	PUSH	HL
   439  01d3  cd0000            	CALL	COMMA
   440  01d6  cd0000            	CALL	NXT
   441  01d9  cd0000            	CALL	GETVAR
   442  01dc  206c              SWAPNZ:	JR	NZ,NOSUCH
   443  01de  d1                	POP	DE
   444  01df  c1                	POP	BC
   445  01e0  b8                	CP	B
   446  01e1  2073              	JR	NZ,MISMAT
   447  01e3  e60f              	AND	00001111B
   448  01e5  286f              	JR	Z,MISMAT
   449  01e7  78                	LD	A,B
   450  01e8  e6c0              	AND	11000000B
   451  01ea  280a              	JR	Z,SWAP1
   452  01ec  0602              	LD	B,2
   453  01ee  f2f601            	JP	P,SWAP1
   454  01f1  eaf601            	JP	PE,SWAP1
   455  01f4  0604              	LD	B,4
   456  01f6  4e                SWAP1:	LD	C,(HL)
   457  01f7  1a                	LD	A,(DE)
   458  01f8  77                	LD	(HL),A
   459  01f9  79                	LD	A,C
   460  01fa  12                	LD	(DE),A
   461  01fb  13                	INC	DE
   462  01fc  23                	INC	HL
   463  01fd  10f7              	DJNZ	SWAP1
   464  01ff  1827              	JR	XEQGO4
   465                          ;
   466                          ;[LET] var = expr
   467                          ;
   468  0201  fe2a              LET0:	CP	'*'
   469  0203  2894              	JR	Z,EXT
   470  0205  fe3d              	CP	'='
   471  0207  2870              	JR	Z,FNEND
   472  0209  fe5b              	CP	'['
   473  020b  2851              	JR	Z,ASM
   474  020d  fd2b              	DEC	IY
   475  020f  cd360e            LET:	CALL	ASSIGN
   476  0212  caf500            	JP	Z,XEQ
   477  0215  3836              	JR	C,SYNTAX	;"Syntax error"
   478  0217  f20000            	JP	P,LETARR	;Numeric array
   479  021a  ea0000            	JP	PE,LETARR	;String array
   480  021d  d5                	PUSH	DE
   481  021e  e5                	PUSH	HL
   482  021f  cd0000            	CALL	EXPRS
   483  0222  dde1              	POP	IX
   484  0224  e1                	POP	HL
   485  0225  cd9e0e            	CALL	MODIFS
   486  0228  c3f500            XEQGO4:	JP	XEQ
   487                          ;
   488                          ; GETSTR - Get string variable
   489                          ;   Inputs: IY = text pointer
   490                          ;  Outputs: B = type
   491                          ;           Z-flag set if comma
   492                          ;
   493  022b  cd0000            GETSTR:	CALL	GETVAR
   494  022e  201a              	JR	NZ,NOSUCH
   495  0230  47                	LD	B,A
   496  0231  e6c0              	AND	11000000B
   497  0233  f25602            	JP	P,MISMAT
   498  0236  ea5302            	JP	PE,BADUSE
   499  0239  cb40              	BIT	0,B
   500  023b  2819              	JR	Z,MISMAT
   501  023d  cd0000            	CALL	NXT
   502  0240  fe2c              	CP	','
   503  0242  c9                	RET
