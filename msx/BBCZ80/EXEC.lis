   269  00a2  cd9011            RUN:	CALL	TERMQ
   270  00a5  280d              	JR	Z,RUN0
   271  00a7  cd0000            CHAIN:	CALL	EXPRS
   272  00aa  3e0d              	LD	A,CR
   273  00ac  12                	LD	(DE),A
   274  00ad  ed7b0000          CHAIN0:	LD	SP,(HIMEM)
   275  00b1  cd0000            	CALL	LOAD0
   276  00b4  ed7b0000          RUN0:	LD	SP,(HIMEM)	;PREPARE FOR RUN
   277  00b8  dd210000          	LD	IX,RANDOM
   278                          ;	Original code used the Z80 refresh register as a seed, but this can
   279                          ;	hang if R is not incremented correctly on some MSX hardware/cores:
   280                          ;RAND:	LD	A,R		;RANDOMISE (CARE!)
   281                          ;	JR	Z,RAND
   282  00bc  3a9efc            	LD	A,(0FC9EH)	;JIFFY - MSX VBLANK COUNTER (avoids R register)
   283  00bf  07                	RLCA
   284  00c0  07                	RLCA
   285  00c1  dd7703            	LD	(IX+3),A
   286  00c4  9f                	SBC	A,A
   287  00c5  dd7704            	LD	(IX+4),A
   288  00c8  cd0000            	CALL	CLEAR
   289  00cb  210000            	LD	HL,0
   290  00ce  220000            	LD	(ERRTRP),HL
   291  00d1  2a0000            	LD	HL,(PAGE)
