   269  00a2  cd9211            RUN:	CALL	TERMQ
   270  00a5  280d              	JR	Z,RUN0
   271  00a7  cd0000            CHAIN:	CALL	EXPRS
   272  00aa  3e0d              	LD	A,CR
   273  00ac  12                	LD	(DE),A
   274  00ad  ed7b0000          CHAIN0:	LD	SP,(HIMEM)
   275  00b1  cd0000            	CALL	LOAD0
   276  00b4  ed7b0000          RUN0:	LD	SP,(HIMEM)	;PREPARE FOR RUN
   277  00b8  dd210000          	LD	IX,RANDOM
   278                          ;	Original code used the Z80 refresh register as a seed, but this can
   279                          ;	hang if R is not incremented correctly on some MSX hardware/cores:
   280                          ;RAND:	LD	A,R		;RANDOMISE (CARE!)
   281                          ;	JR	Z,RAND
   282                          ;
   283                          ;	LD	A,(0FC9EH)	;JIFFY - MSX VBLANK COUNTER (avoids R register)
   284                          RAND:
   285  00bc  ed5f              	LD A,R
   286  00be  b7                	OR A
   287  00bf  28fb              	JR Z,RAND
   288  00c1  07                	RLCA
   289  00c2  07                	RLCA
   290  00c3  dd7703            	LD	(IX+3),A
   291  00c6  9f                	SBC	A,A
   292  00c7  dd7704            	LD	(IX+4),A
   293  00ca  cd0000            	CALL	CLEAR
   294  00cd  210000            	LD	HL,0
   295  00d0  220000            	LD	(ERRTRP),HL
   296  00d3  2a0000            	LD	HL,(PAGE)
