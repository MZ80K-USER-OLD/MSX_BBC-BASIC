  3082                          ; NSCAN - scan for token at start of line, with nesting of inner structures
  3083                          ; Alternative entry at NSCAN1 with L = level (used by CASE)
  3084                          ;
  3085                          ;   Inputs: B = token to find (1, start of line)
  3086                          ;           C = token to find (2, start of line)
  3087                          ;           E = token to nest (end of line)
  3088                          ;           D = token to unnest (start of line)
  3089                          ;           IY = start search area (line length byte)
  3090                          ;  Outputs: NZ if not found
  3091                          ;           Z if found, IY points to byte after token
  3092                          ; Destroys: A,B,C,L,IY,F
  3093                          ;
  3094  126b  2e00              NSCAN:	LD	L,0		;nest level
  3095  126d  fd7e00            NSCAN1:	LD	A,(IY)		;get line length
  3096  1270  b7                	OR	A		;test zero = end of prog
  3097  1271  2834              	JR	Z,NSCAN6
  3098  1273  fd7e03            	LD	A,(IY+3)	;initial token
  3099  1276  b8                	CP	B		;test value reqd
  3100  1277  281d              	JR	Z,NSCAN3	;found (1)
  3101  1279  b9                	CP	C
  3102  127a  281a              	JR	Z,NSCAN3	;found (2)
  3103  127c  ba                NSCAN7:	CP	D		;unnest?
  3104  127d  2822              	JR	Z,NSCAN5
  3105  127f  c5                NSCAN2:	PUSH	BC
  3106  1280  0600              	LD	B,0
  3107  1282  fd4e00            	LD	C,(IY)
  3108  1285  fd09              	ADD	IY,BC		;go to next line
  3109  1287  fd7efe            	LD	A,(IY-2)
  3110  128a  bb                	CP	E		;nest?
  3111  128b  79                	LD	A,C
  3112  128c  c1                	POP	BC
  3113  128d  20de              	JR	NZ,NSCAN1	;continue
  3114  128f  fe05              	CP	5		;empty line ?
  3115  1291  38da              	JR	C,NSCAN1	;continue
  3116  1293  2c                	INC	L		;increment nest level
  3117  1294  18d7              	JR	NSCAN1		;continue
  3118                          ;
  3119  1296  2c                NSCAN3:	INC	L
  3120  1297  2d                	DEC	L
  3121  1298  20e2              	JR	NZ,NSCAN7
  3122  129a  010400            NSCAN4:	LD	BC,4
  3123  129d  fd09              	ADD	IY,BC
  3124  129f  af                	XOR	A		;Z
  3125  12a0  c9                	RET
  3126                          ;
