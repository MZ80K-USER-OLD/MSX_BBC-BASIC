   299  00dc  fd2a0000          	LD	IY,(PAGE)
   300  00e0  cd3701            XEQ0:	CALL	NEWLIN
   301  00e3  fd7e00            	LD	A,(IY)
   302  00e6  fe8b              	CP	TELSE
   303  00e8  ca8b09            	JP	Z,MELSE		;ELSE
   304  00eb  fec9              	CP	TWHEN
   305  00ed  ca9e09            	JP	Z,WHEN		;WHEN
   306  00f0  fecc              	CP	TOTHERWISE
   307  00f2  ca9e09            	JP	Z,WHEN
   308  00f5  fd220000          XEQ:	LD	(CURLIN),IY	;ERROR POINTER
   309  00f9  cd0000            	CALL	TRAP		;CHECK KEYBOARD
   310  00fc  cd0000            XEQ1:	CALL	NXT
   311  00ff  fd23              	INC	IY
   312  0101  fe3a              	CP	':'		;SEPARATOR
   313  0103  28f7              	JR	Z,XEQ1
   314  0105  fe0d              	CP	CR
   315  0107  28d7              	JR	Z,XEQ0		;NEW PROGRAM LINE
   316  0109  fe91              	CP	TLAST
   317  010b  eaef01            	JP	PE,LET0		;IMPLIED LET
   318  010e  d6c0              	SUB	TCMD
   319  0110  fa7201            	JP	M,EXTRAS
   320  0113  87                	ADD	A,A
   321  0114  4f                	LD	C,A
   322  0115  0600              	LD	B,0
   323  0117  210000            	LD	HL,CMDTAB
   324  011a  09                	ADD	HL,BC
   325  011b  7e                	LD	A,(HL)		;TABLE ENTRY
   326  011c  23                	INC	HL
   327  011d  66                	LD	H,(HL)
   328  011e  6f                	LD	L,A
   329  011f  cd0000            	CALL	NXT
   330  0122  e9                	JP	(HL)		;EXECUTE STATEMENT
   331                          ;
   332                          ;END
   333                          ;
   334  0123  fde5              ENDIM:	PUSH	IY
   335  0125  e1                	POP	HL
   336  0126  ed4b0000          	LD	BC,(PAGE)
   337  012a  ed42              	SBC	HL,BC		;IMMEDIATE MODE ?
   338  012c  da0000            	JP	C,CLOOP
   339  012f  1e00              END:	LD	E,0
   340  0131  cd0000            	CALL	OSSHUT		;CLOSE ALL FILES
   341  0134  c30000            	JP	WARM		;"Ready"
   342                          ;
   343  0137  fd7e00            NEWLIN:	LD	A,(IY+0)	;A=LINE LENGTH
   344  013a  010300            	LD	BC,3
   345  013d  fd09              	ADD	IY,BC
