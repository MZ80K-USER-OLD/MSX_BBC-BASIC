  3155  12ba  fe10              	CP	TEXIT
  3156  12bc  2830              	JR	Z,WSRCHE
  3157  12be  b8                	CP	B
  3158  12bf  2829              	JR	Z,WSRCHX
  3159  12c1  b9                	CP	C
  3160  12c2  2823              	JR	Z,WSRCHP
  3161  12c4  fe0d              	CP	CR
  3162  12c6  20e4              	JR	NZ,WSRCH
