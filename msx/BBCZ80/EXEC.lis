  3139                          ; WSRCH - search for token, with nesting of inner structures
  3140                          ;
  3141                          ;   Inputs: B = token to find or unnest (anywhere)
  3142                          ;           C = token to nest (anywhere), ignore after EXIT
  3143                          ;           D = ordinal (1 = find first token, 2 = second)
  3144                          ;           IY = address to start looking
  3145                          ;  Outputs: IY points to byte after that found
  3146                          ;           if not found abort to END
  3147                          ; Destroys: A,D,IY,F
  3148                          ;
  3149  12ac  fd7e00            WSRCH:	LD	A,(IY)
  3150  12af  fd23              	INC	IY
  3151  12b1  fe22              	CP	'"'
