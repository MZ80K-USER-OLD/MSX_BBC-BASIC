   300  00eb  ca9c09            	JP	Z,WHEN		;WHEN
   301  00ee  fecc              	CP	TOTHERWISE
   302  00f0  ca9c09            	JP	Z,WHEN
   303  00f3  fd220000          XEQ:	LD	(CURLIN),IY	;ERROR POINTER
   304  00f7  cd0000            	CALL	TRAP		;CHECK KEYBOARD
   305  00fa  cd0000            XEQ1:	CALL	NXT
   306  00fd  fd23              	INC	IY
   307  00ff  fe3a              	CP	':'		;SEPARATOR
   308  0101  28f7              	JR	Z,XEQ1
   309  0103  fe0d              	CP	CR
   310  0105  28d7              	JR	Z,XEQ0		;NEW PROGRAM LINE
   311  0107  fe91              	CP	TLAST
   312  0109  eaed01            	JP	PE,LET0		;IMPLIED LET
   313  010c  d6c0              	SUB	TCMD
   314  010e  fa7001            	JP	M,EXTRAS
   315  0111  87                	ADD	A,A
   316  0112  4f                	LD	C,A
   317  0113  0600              	LD	B,0
   318  0115  210000            	LD	HL,CMDTAB
   319  0118  09                	ADD	HL,BC
   320  0119  7e                	LD	A,(HL)		;TABLE ENTRY
   321  011a  23                	INC	HL
   322  011b  66                	LD	H,(HL)
   323  011c  6f                	LD	L,A
   324  011d  cd0000            	CALL	NXT
   325  0120  e9                	JP	(HL)		;EXECUTE STATEMENT
   326                          ;
   327                          ;END
   328                          ;
   329  0121  fde5              ENDIM:	PUSH	IY
   330  0123  e1                	POP	HL
   331  0124  ed4b0000          	LD	BC,(PAGE)
   332  0128  ed42              	SBC	HL,BC		;IMMEDIATE MODE ?
   333  012a  da0000            	JP	C,CLOOP
   334  012d  1e00              END:	LD	E,0
   335  012f  cd0000            	CALL	OSSHUT		;CLOSE ALL FILES
   336  0132  c30000            	JP	WARM		;"Ready"
   337                          ;
   338  0135  fd7e00            NEWLIN:	LD	A,(IY+0)	;A=LINE LENGTH
   339  0138  010300            	LD	BC,3
   340  013b  fd09              	ADD	IY,BC
   341  013d  b7                	OR	A
   342  013e  28e1              	JR	Z,ENDIM		;LENGTH=0, EXIT
   343  0140  2a0000            	LD	HL,(TRACEN)
   344  0143  7c                	LD	A,H
   345  0144  b5                	OR	L
   346  0145  c8                	RET	Z
   347  0146  fd56ff            	LD	D,(IY-1)	;DE = LINE NUMBER
   348  0149  fd5efe            	LD	E,(IY-2)
   349  014c  ed52              	SBC	HL,DE
   350  014e  d8                	RET	C
   351  014f  eb                	EX	DE,HL
   352  0150  3e5b              	LD	A,'['		;TRACE
   353  0152  cd0000            	CALL	OUTCHR
   354  0155  cd0000            	CALL	PBCDL
   355  0158  3e5d              	LD	A,']'
   356  015a  cd0000            	CALL	OUTCHR
   357  015d  3e20              	LD	A,' '
   358  015f  c30000            	JP	OUTCHR
