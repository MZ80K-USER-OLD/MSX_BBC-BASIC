   469                          ; GETSTR - Get string variable
   470                          ;   Inputs: IY = text pointer
   471                          ;  Outputs: B = type
   472                          ;           Z-flag set if comma
   473                          ;
   474  0217  cd0000            GETSTR:	CALL	GETVAR
   475  021a  201a              	JR	NZ,NOSUCH
   476  021c  47                	LD	B,A
   477  021d  e6c0              	AND	11000000B
