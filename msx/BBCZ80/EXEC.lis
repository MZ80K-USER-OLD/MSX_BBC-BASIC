   474                          ; GETSTR - Get string variable
   475                          ;   Inputs: IY = text pointer
   476                          ;  Outputs: B = type
   477                          ;           Z-flag set if comma
   478                          ;
   479  0219  cd0000            GETSTR:	CALL	GETVAR
   480  021c  201a              	JR	NZ,NOSUCH
   481  021e  47                	LD	B,A
   482  021f  e6c0              	AND	11000000B
