  3119                          ; NSCAN - scan for token at start of line, with nesting of inner structures
  3120                          ; Alternative entry at NSCAN1 with L = level (used by CASE)
  3121                          ;
  3122                          ;   Inputs: B = token to find (1, start of line)
  3123                          ;           C = token to find (2, start of line)
  3124                          ;           E = token to nest (end of line)
  3125                          ;           D = token to unnest (start of line)
  3126                          ;           IY = start search area (line length byte)
  3127                          ;  Outputs: NZ if not found
  3128                          ;           Z if found, IY points to byte after token
  3129                          ; Destroys: A,B,C,L,IY,F
  3130                          ;
  3131  129b  2e00              NSCAN:	LD	L,0		;nest level
  3132  129d  fd7e00            NSCAN1:	LD	A,(IY)		;get line length
  3133  12a0  b7                	OR	A		;test zero = end of prog
  3134  12a1  2834              	JR	Z,NSCAN6
  3135  12a3  fd7e03            	LD	A,(IY+3)	;initial token
  3136  12a6  b8                	CP	B		;test value reqd
  3137  12a7  281d              	JR	Z,NSCAN3	;found (1)
  3138  12a9  b9                	CP	C
  3139  12aa  281a              	JR	Z,NSCAN3	;found (2)
  3140  12ac  ba                NSCAN7:	CP	D		;unnest?
  3141  12ad  2822              	JR	Z,NSCAN5
  3142  12af  c5                NSCAN2:	PUSH	BC
  3143  12b0  0600              	LD	B,0
  3144  12b2  fd4e00            	LD	C,(IY)
  3145  12b5  fd09              	ADD	IY,BC		;go to next line
  3146  12b7  fd7efe            	LD	A,(IY-2)
  3147  12ba  bb                	CP	E		;nest?
  3148  12bb  79                	LD	A,C
  3149  12bc  c1                	POP	BC
  3150  12bd  20de              	JR	NZ,NSCAN1	;continue
  3151  12bf  fe05              	CP	5		;empty line ?
  3152  12c1  38da              	JR	C,NSCAN1	;continue
  3153  12c3  2c                	INC	L		;increment nest level
  3154  12c4  18d7              	JR	NSCAN1		;continue
  3155                          ;
  3156  12c6  2c                NSCAN3:	INC	L
  3157  12c7  2d                	DEC	L
  3158  12c8  20e2              	JR	NZ,NSCAN7
  3159  12ca  010400            NSCAN4:	LD	BC,4
  3160  12cd  fd09              	ADD	IY,BC
  3161  12cf  af                	XOR	A		;Z
  3162  12d0  c9                	RET
