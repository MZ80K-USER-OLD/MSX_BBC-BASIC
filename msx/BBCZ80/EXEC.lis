  3087                          ; NSCAN - scan for token at start of line, with nesting of inner structures
  3088                          ; Alternative entry at NSCAN1 with L = level (used by CASE)
  3089                          ;
  3090                          ;   Inputs: B = token to find (1, start of line)
  3091                          ;           C = token to find (2, start of line)
  3092                          ;           E = token to nest (end of line)
  3093                          ;           D = token to unnest (start of line)
  3094                          ;           IY = start search area (line length byte)
  3095                          ;  Outputs: NZ if not found
  3096                          ;           Z if found, IY points to byte after token
  3097                          ; Destroys: A,B,C,L,IY,F
  3098                          ;
  3099  126d  2e00              NSCAN:	LD	L,0		;nest level
  3100  126f  fd7e00            NSCAN1:	LD	A,(IY)		;get line length
  3101  1272  b7                	OR	A		;test zero = end of prog
  3102  1273  2834              	JR	Z,NSCAN6
  3103  1275  fd7e03            	LD	A,(IY+3)	;initial token
  3104  1278  b8                	CP	B		;test value reqd
  3105  1279  281d              	JR	Z,NSCAN3	;found (1)
  3106  127b  b9                	CP	C
  3107  127c  281a              	JR	Z,NSCAN3	;found (2)
  3108  127e  ba                NSCAN7:	CP	D		;unnest?
  3109  127f  2822              	JR	Z,NSCAN5
  3110  1281  c5                NSCAN2:	PUSH	BC
  3111  1282  0600              	LD	B,0
  3112  1284  fd4e00            	LD	C,(IY)
  3113  1287  fd09              	ADD	IY,BC		;go to next line
  3114  1289  fd7efe            	LD	A,(IY-2)
  3115  128c  bb                	CP	E		;nest?
  3116  128d  79                	LD	A,C
  3117  128e  c1                	POP	BC
  3118  128f  20de              	JR	NZ,NSCAN1	;continue
  3119  1291  fe05              	CP	5		;empty line ?
  3120  1293  38da              	JR	C,NSCAN1	;continue
  3121  1295  2c                	INC	L		;increment nest level
  3122  1296  18d7              	JR	NSCAN1		;continue
  3123                          ;
  3124  1298  2c                NSCAN3:	INC	L
  3125  1299  2d                	DEC	L
  3126  129a  20e2              	JR	NZ,NSCAN7
  3127  129c  010400            NSCAN4:	LD	BC,4
  3128  129f  fd09              	ADD	IY,BC
  3129  12a1  af                	XOR	A		;Z
  3130  12a2  c9                	RET
  3131                          ;
  3132  12a3  2d                NSCAN5:	DEC	L		;decrement nest level
  3133  12a4  f28112            	JP	P,NSCAN2
  3134  12a7  18f3              	JR	NSCAN4
  3135                          ;
  3136  12a9  f601              NSCAN6:	OR	1		;NZ
  3137  12ab  c9                	RET
