              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
    98  039a  00                DOS_VER:	DEFS	1		;MSX-DOS VERSION
    99  039b  0000000000000000  DIRFIB:	DEFS	64		;MSX-DOS2 FFIRST/FNEXT file information block
              0000000000000000  
              0000000000000000  
              0000000000000000  
