              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              00000000          
    62                          OC	EQU	STAVAR+15*4	;CODE ORIGIN (O%)
    63                          PC	EQU	STAVAR+16*4	;PROGRAM COUNTER (P%)
    64  026c  0000000000000000  DYNVAR:	DEFS	54*2		;DYN. VARIABLE POINTERS
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              00000000          
    65  02d8  0000              FNPTR:	DEFS	2		;DYN. FUNCTION POINTER
    66  02da  0000              PROPTR:	DEFS	2		;DYN. PROCEDURE POINTER
    67                          ;
    68  02dc  0000              PAGE:	DEFS	2		;START OF USER PROGRAM
    69  02de  0000              LOMEM:	DEFS	2		;START OF DYN. STORAGE
    70  02e0  0000              FREE:	DEFS	2		;FIRST FREE-SPACE BYTE
    71  02e2  0000              HIMEM:	DEFS	2		;FIRST BYTE ABOVE STACK
    72  02e4  0000              LIBASE:	DEFS	2		;START OF FIRST LIBRARY
    73                          ;
    74  02e6  0000              TRACEN:	DEFS	2		;TRACE FLAG AND NUMBER
    75  02e8  0000              AUTONO:	DEFS	2		;AUTO FLAG AND NUMBER
    76  02ea  0000              ERRTRP:	DEFS	2		;ON ERROR STMT POINTER \
    77  02ec  0000              ONERSP:	DEFS	2		;ON ERROR LOCAL STKPTR /
    78  02ee  0000              ERRTXT:	DEFS	2		;ERROR MESSAGE POINTER
    79  02f0  0000              DATPTR:	DEFS	2		;DATA POINTER
    80  02f2  0000              ERL:	DEFS	2		;LINE NO OF LAST ERROR
    81  02f4  0000              CURLIN:	DEFS	2		;POINTER TO CURRENT LINE
    82  02f6  0000000000        RANDOM:	DEFS	5		;RANDOM NUMBER
    83  02fb  00                COUNT:	DEFS	1		;PRINT POSITION
    84  02fc  00                WIDTH:	DEFS	1		;PRINT WIDTH
    85  02fd  00                ERR:	DEFS	1		;ERROR NUMBER
    86  02fe  00                LISTON:	DEFS	1		;LISTO & OPT FLAG
    87  02ff  00                INCREM:	DEFS	1		;AUTO INCREMENT
    88                          ; OS WORK AREAA
    89  0300  00                FILE_HANDLE:	DEFS	1		;MSX-DOS2 file handle used by OSLOAD
    90  0301  0000              FILE_BUFADRS:	DEFS	2		; バッファのアドレス保存用
    91  0303  0000              FILE_MAXSIZE:	DEFS	2		; 最大読み込みバイト数
    92  0305  0000              REQ_BYTES:      DEFS    2       ; 読み込み要求バイト数
    93  0307  0000000000000000  DOS2_HANDLES:	DEFS	9		; DOS2 file handles, indexed by BASIC channel
              00                
    94  0310  0000000000000000  DOS2_EOF:	DEFS	9		; EOF flags, indexed by BASIC channel
              00                
    95  0319  00                DOS2_IOBUF:	DEFS	1		; Single-byte BGET/BPUT transfer buffer
    96  031a  0000000000000000  PATHBUF:	DEFS	64		;PATH WORK BUFFER FOR MSX-DOS2 / SUBDIR SUPPORT
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
    97  035a  0000000000000000  PATHBUF2:	DEFS	64		;Second pathname for MSX-DOS2 rename
              0000000000000000  
