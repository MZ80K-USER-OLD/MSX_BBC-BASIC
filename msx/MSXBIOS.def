; MSX BIOS entry points and system variables.

IFNDEF BDOS
BDOS		EQU	$0005			; MSX-DOS API CALL
ENDIF

; MSX BIOS entries
CALSLT		EQU	$001C
IDBYT0		EQU	$002B
CHGMOD      EQU $005F
WRTVDP      EQU $0047           ; write VDP register
INITXT		EQU	$006C			; select screen mode 0
INIT32		EQU	$006F			; select screen mode 1
CHSNS		EQU	$009C
CHGET		EQU	$009F			; 1文字入力
CHPUT		EQU	$00A2			; 1文字出力
BEEP		EQU	$00C0
POSIT		EQU	$00C6			; カーソル位置指定
CLRSPR      EQU $0069           ; スプライトの初期化
CALPAT      EQU $0084           ; スプライトのパターンアドレス計算
CALATR      EQU $0087           ; スプライトのアトリビュートアドレス計算
GSPSIZ      EQU $008A           ; スプライトサイズ
NSTWRT      EQU $0171           ; VDPの書き込みアドレス
NSETRD      EQU $016E           ; VDPの読み込みアドレス
LDIRMV      EQU $0059           ; VRAMからメモリへデータをブロック転送します
LDIRVM      EQU $005C           ; メモリからVRAMへデータをブロック転送します
WRTVRM      EQU $004D           ; Aの値をHLのVRAMアドレスへ書き込み

CLS		EQU	$00C3			    ; 画面消去
PINLINE	EQU	$00AE			    ; 一行入力
KILBUF		EQU	$0156			; Clear input buffer
;
; BIOS/BASIC  WORK AREA
;
BUFMIN		EQU	$F55D			; 入力バッファ-1
BUF		    EQU	$F55E			; BASIC 入力バッファ、終端が0
CLIKSW		EQU	$F3DB
EXPTBL		EQU	$FCC1			; スロットテーブル

LINL40		EQU	$F3AE			; screen width mode 0
LINL32		EQU	$F3AF			; screen width mode 1
LINLEN		EQU	$F3B0			; screen width
CSRY		EQU	$F3DC			; cursor row position
CSRX		EQU	$F3DD			; cursor column position
EXBRSA		EQU	$FAF8			; slotid subrom
JIFFY       EQU $FC9E           ; vsync counter
RG1SAV      EQU $F3E0           ; VDP register 1 shadow
CSTYLE      EQU $FCAA           ; cusor style 

